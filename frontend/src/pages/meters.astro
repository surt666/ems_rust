---
// Målere — meter registry (NEW). The MQTT/LoRaWAN gateway/meter *creation*
// flow now lives at /gateways (linked from this page + the Målere menu).
// Data is static today; DataGrid carries the future endpoint contract
// (data-endpoint="/query/meters") for drop-in HTMX wiring later.
import Layout from "../layouts/Layout.astro";
import DataGrid from "../components/DataGrid.astro";
import FilterOverlay from "../components/FilterOverlay.astro";

// Representative rows (mirror the EMS registry columns; replaced by the
// /query/meters fragment when the backend is ready).
const meters = [
  { building: "Administrationsbygning A", type: "Fjernvarme", energy: "fjernvarme", hierarchy: "Hovedmåler", label: "District heating billing", uid: "HO593448", tags: "Afregning" },
  { building: "Administrationsbygning A", type: "EL", energy: "el", hierarchy: "Hovedmåler", label: "Elmåler hovedtavle", uid: "EL120014", tags: "" },
  { building: "Bygning B", type: "Vand", energy: "vand", hierarchy: "Bimåler", label: "Vandmåler kælder", uid: "VA771203", tags: "Lækage" },
  { building: "Kalmar", type: "Fjernvarme", energy: "fjernvarme", hierarchy: "Hovedmåler", label: "District Meter Billing", uid: "HO593459", tags: "" },
  { building: "Kalmar", type: "EL", energy: "el", hierarchy: "Bimåler", label: "EL ventilation", uid: "EL120087", tags: "Ventilation" },
  { building: "Kristianstad", type: "Varme", energy: "varme", hierarchy: "Hovedmåler", label: "Heating main meter", uid: "HO593470", tags: "" },
  { building: "Sölvesborg", type: "Køling", energy: "vand", hierarchy: "Hovedmåler", label: "Test meter 4", uid: "HO593484", tags: "Køling" },
  { building: "Karlshamn 1", type: "Naturgas", energy: "gas", hierarchy: "Hovedmåler", label: "Gas main meter", uid: "GA200431", tags: "" },
];
---
<Layout title="Målere">
  <div class="page-container">
    <div class="view-header">
      <div>
        <h1 class="page-title"><span data-i18n="nav.meters">Målere</span> <span class="muted">— Bolag AB Janus</span></h1>
        <p class="page-description">Registret over alle målere i den valgte kontekst.</p>
      </div>
      <div class="view-actions">
        <a href="/gateways" class="btn-secondary">+ <span data-i18n="nav.gateways">Opret måler / gateway</span></a>
        <button type="button" class="btn-secondary">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
          <span data-i18n="common.export">Eksport</span>
        </button>
      </div>
    </div>

    <DataGrid
      count={`<strong>${meters.length}</strong> målere (heraf 0 valgt)`}
      searchPlaceholder="Søg efter unikt id, målerbetegnelse…"
      endpoint="/query/meters"
    >
      <FilterOverlay slot="actions">
        <div class="filter-overlay__group">
          <span class="filter-overlay__group-title">Bygningsfiltre</span>
          <div class="form-field">
            <label class="form-label">Bygningsanvendelse</label>
            <select class="form-select"><option>Alle (4)</option></select>
          </div>
          <div class="form-field">
            <label class="form-label">Bygninger</label>
            <select class="form-select"><option>Alle (12)</option></select>
          </div>
        </div>
        <div class="filter-overlay__group">
          <span class="filter-overlay__group-title">Måler-filtre</span>
          <div class="form-field">
            <label class="form-label">Målertyper <span class="combinator" _="on click if my textContent is 'og' set my textContent to 'eller' else set my textContent to 'og'">og</span></label>
            <select class="form-select"><option>Alle (11)</option></select>
          </div>
          <div class="form-field">
            <label class="form-label">Tags</label>
            <select class="form-select"><option>Vælg tags (3)</option></select>
          </div>
          <div class="form-field">
            <label class="form-label">Adfærd</label>
            <select class="form-select"><option>Alle (3)</option></select>
          </div>
        </div>
      </FilterOverlay>

      <table class="data-table">
        <thead>
          <tr>
            <th><input type="checkbox" aria-label="Vælg alle"
              _="on change set checked to my checked then for c in <tbody input[type=checkbox]/> in the closest .data-grid set c.checked to checked" /></th>
            <th data-i18n="common.building">Bygning</th>
            <th>Målertype</th>
            <th>Hierarki</th>
            <th>Målerbetegnelse</th>
            <th>Unikt Id</th>
            <th>Tags</th>
          </tr>
        </thead>
        <tbody>
          {meters.map((m) => (
            <tr>
              <td><input type="checkbox" aria-label={`Vælg ${m.label}`} /></td>
              <td>{m.building}</td>
              <td><span class={`badge energy-${m.energy}`}>{m.type}</span></td>
              <td>{m.hierarchy}</td>
              <td>{m.label}</td>
              <td>{m.uid}</td>
              <td>{m.tags ? <span class="badge">{m.tags}</span> : <span class="muted">—</span>}</td>
            </tr>
          ))}
        </tbody>
      </table>

      <Fragment slot="pagination">
        <span>Side 1 af 1</span>
      </Fragment>
    </DataGrid>
  </div>
</Layout>
