---
import Layout from '../layouts/Layout.astro';
import MasterData from '../components/MasterData.astro';

const API_BASE_URL = import.meta.env.PUBLIC_API_BASE_URL;
---

<Layout title="Stamdata">
	<div class="page-container" x-data="{
		deleteDialogOpen: false,
		openDeleteDialog() {
			const nodeId = sessionStorage.getItem('selectedNodeId');
			if (!nodeId) {
				alert('Vælg venligst en node først');
				return;
			}
			this.deleteDialogOpen = true;
			this.$refs.deleteDialog.showModal();
		},
		closeDeleteDialog() {
			this.deleteDialogOpen = false;
			this.$refs.deleteDialog.close();
		},
		async deleteNode() {
			const nodeId = sessionStorage.getItem('selectedNodeId');

			if (!nodeId) {
				alert('Ingen node valgt');
				return;
			}

			try {
				const response = await fetch('/hierarchy/command', {
					method: 'POST',
					headers: {
						'Content-Type': 'application/json',
					},
					body: JSON.stringify({
						action: 'delete_node',
						data: {
							id: nodeId
						}
					})
				});

				if (!response.ok) {
					const errorText = await response.text();
					alert('Fejl ved sletning: ' + errorText);
					return;
				}

				sessionStorage.removeItem('selectedNodeId');
				sessionStorage.removeItem('selectedNodePath');

				this.closeDeleteDialog();
				location.reload();
			} catch (error) {
				alert('Fejl ved sletning: ' + error.message);
			}
		}
	}">
		<!-- Action Dropdown -->
		<div style="display: grid; grid-template-columns: 1fr auto; gap: 1rem; margin-bottom: 1rem;">
			<div></div>
			<div style="position: relative;" x-data="{ open: false }">
				<button @click="open = !open" class="btn-primary">
					Handlinger ▾
				</button>
				<div x-show="open" @click.away="open = false" class="action-dropdown">
					<a href="#" _="on click halt the event then call #create-dialog.showModal() then set open to false">Opret under element</a>
					<a href="#" @click.prevent="openDeleteDialog(); open = false" class="danger-link">Slet</a>
					<a href="#" >Editer</a>
				</div>
			</div>
		</div>

		<!-- Tabbed per-node view -->
		<MasterData />

		<!-- Create Node Dialog -->
		<dialog id="create-dialog" x-data="createNode()"
			@schema-updated.window="onSchema($event.detail)"
			_="on click if event.target == me then call me.close()">
			<div class="dialog-header">
				<h2>OPRET HIERARKI ELEMENT</h2>
				<button _="on click call #create-dialog.close()" class="btn-close">&times;</button>
			</div>

			<div class="dialog-body">
				<div id="node-form-error" class="hidden login-error" style="display:none;margin-bottom:1rem;"></div>
				<form id="create-node-form" class="form"
					hx-post={`${API_BASE_URL}/hierarchy/command`}
					hx-swap="none"
					hx-vals="js:{parent_id: sessionStorage.getItem('selectedNodePath') + '#' + sessionStorage.getItem('selectedNodeId')}"
					hx-on::after-request="if(event.detail.elt.id === 'create-node-form' && event.detail.successful) { document.querySelector('dialog').close(); location.reload(); } else if(event.detail.elt.id === 'create-node-form') { document.getElementById('node-form-error').textContent = event.detail.xhr.responseText; document.getElementById('node-form-error').style.display = 'block'; }">
					<input type="hidden" name="action" value="add_node" />

					<div class="form-row">
						<label class="form-label">Navn</label>
						<input type="text" name="data.name" required class="form-input" />
						<span class="required">*</span>
					</div>

					<div class="form-row">
						<label class="form-label">Type</label>
						<select id="node-type-select" name="data.type" required class="form-select"
							@change="nodeType = $event.target.value"
							_="on change
								for field in .node-fields
									add @style='display:none' to field
								end
								if my.value is 'partner' remove @style from .node-fields-partner end
								if my.value is 'company' remove @style from .node-fields-company end
								if my.value is 'property' remove @style from .node-fields-property end
								if my.value is 'building' remove @style from .node-fields-building end
								if my.value is 'area' remove @style from .node-fields-area end
								if my.value is 'group' remove @style from .node-fields-group end">
							<option value="partner">Partner</option>
							<option value="company">Company</option>
							<option value="property">Property</option>
							<option value="building">Building</option>
							<option value="area">Area</option>
							<option value="group">Group</option>
						</select>
						<span class="required">*</span>
					</div>

					<!-- Partner Fields -->
					<div class="form node-fields node-fields-partner">
						<div class="form-row-2col">
							<label class="form-label">Email</label>
							<input type="email" name="data.email" class="form-input" />
						</div>
						<div class="form-row-2col">
							<label class="form-label">Telefon (landskode)</label>
							<input type="text" name="data.phone.country_code" placeholder="45" pattern="[0-9]{1,4}" maxlength="4" class="form-input" />
						</div>
						<div class="form-row-2col">
							<label class="form-label">Telefon (nummer)</label>
							<input type="tel" name="data.phone.number" pattern="[0-9\s\-\+]{8,20}" maxlength="20" class="form-input" />
						</div>
						<div class="bordered-section" style="margin-top: 1rem;">
							<h3 class="section-title">Adresse</h3>
							<div class="form-row-2col">
								<label class="form-label">Land</label>
								<input type="text" name="data.address.country" maxlength="100" pattern="[A-Za-zÆØÅæøå\s\-]*" class="form-input" />
							</div>
							<div class="form-row-2col">
								<label class="form-label">Gade</label>
								<input type="text" name="data.address.street" maxlength="200" class="form-input" />
							</div>
							<div class="form-row-2col">
								<label class="form-label">Husnummer</label>
								<input type="number" name="data.address.nr" min="0" max="9999" step="1" class="form-input" />
							</div>
							<div class="form-row-2col">
								<label class="form-label">Postnummer</label>
								<input type="number" name="data.address.zip" min="0" max="99999" step="1" class="form-input" />
							</div>
						</div>
					</div>

					<!-- Company Fields -->
					<div class="form node-fields node-fields-company" style="display:none">
						<div class="form-row-2col">
							<label class="form-label">Hierarki-skema</label>
							<button type="button" class="btn-secondary"
								@click="document.getElementById('schema-designer-dialog').showModal()">
								<span x-show="!schemaValid">Design skema *</span>
								<span x-show="schemaValid">✓ Skema defineret (rediger)</span>
							</button>
						</div>
						<div class="form-row-2col">
							<label class="form-label">Email</label>
							<input type="email" name="data.email" class="form-input" />
						</div>
						<div class="form-row-2col">
							<label class="form-label">CVR</label>
							<input type="number" name="data.cvr" min="10000000" max="99999999" step="1" placeholder="12345678" class="form-input" />
						</div>
						<div class="form-row-2col">
							<label class="form-label">Telefon (landskode)</label>
							<input type="text" name="data.phone.country_code" placeholder="45" pattern="[0-9]{1,4}" maxlength="4" class="form-input" />
						</div>
						<div class="form-row-2col">
							<label class="form-label">Telefon (nummer)</label>
							<input type="tel" name="data.phone.number" pattern="[0-9\s\-\+]{8,20}" maxlength="20" class="form-input" />
						</div>
						<div class="form-row-2col">
							<label class="form-label">Kontakt</label>
							<input type="text" name="data.contact" maxlength="200" class="form-input" />
						</div>
						<div class="form-row-2col">
							<label class="form-label">Hjemmeside</label>
							<input type="url" name="data.homepage" class="form-input" />
						</div>
						<div class="form-row-2col">
							<label class="form-label">Status</label>
							<select name="data.status" class="form-select">
								<option value="Active">Active</option>
								<option value="Inactive">Inactive</option>
								<option value="Suspended">Suspended</option>
							</select>
						</div>
						<div class="form-row-2col">
							<label class="form-label">SLA</label>
							<select name="data.sla" class="form-select">
								<option value="Standard">Standard</option>
								<option value="Premium">Premium</option>
								<option value="Enterprise">Enterprise</option>
							</select>
						</div>
						<div class="bordered-section" style="margin-top: 1rem;">
							<h3 class="section-title">Adresse</h3>
							<div class="form-row-2col">
								<label class="form-label">Land</label>
								<input type="text" name="data.address.country" maxlength="100" pattern="[A-Za-zÆØÅæøå\s\-]*" class="form-input" />
							</div>
							<div class="form-row-2col">
								<label class="form-label">Gade</label>
								<input type="text" name="data.address.street" maxlength="200" class="form-input" />
							</div>
							<div class="form-row-2col">
								<label class="form-label">Husnummer</label>
								<input type="number" name="data.address.nr" min="0" max="9999" step="1" class="form-input" />
							</div>
							<div class="form-row-2col">
								<label class="form-label">Postnummer</label>
								<input type="number" name="data.address.zip" min="0" max="99999" step="1" class="form-input" />
							</div>
						</div>
					</div>

					<!-- Property Fields -->
					<div class="form node-fields node-fields-property" style="display:none">
						<div class="form-row-2col">
							<label class="form-label">Anvendelse</label>
							<input type="text" name="data.usage" class="form-input" />
						</div>
						<div class="form-row-2col">
							<label class="form-label">BBR</label>
							<input type="text" name="data.bbr" pattern="[0-9]*" maxlength="20" class="form-input" />
						</div>
						<div class="form-row-2col">
							<label class="form-label">Vejrstation</label>
							<input type="text" name="data.weather_station" maxlength="100" class="form-input" />
						</div>
						<div class="bordered-section" style="margin-top: 1rem;">
							<h3 class="section-title">Lokation</h3>
							<div class="form-row-2col">
								<label class="form-label">Breddegrad</label>
								<input type="number" step="0.000001" name="data.location.lat" min="-90" max="90" placeholder="55.6761" class="form-input" />
							</div>
							<div class="form-row-2col">
								<label class="form-label">Længdegrad</label>
								<input type="number" step="0.000001" name="data.location.long" min="-180" max="180" placeholder="12.5683" class="form-input" />
							</div>
						</div>
						<div class="bordered-section" style="margin-top: 1rem;">
							<h3 class="section-title">Adresse</h3>
							<div class="form-row-2col">
								<label class="form-label">Land</label>
								<input type="text" name="data.address.country" maxlength="100" pattern="[A-Za-zÆØÅæøå\s\-]*" class="form-input" />
							</div>
							<div class="form-row-2col">
								<label class="form-label">Gade</label>
								<input type="text" name="data.address.street" maxlength="200" class="form-input" />
							</div>
							<div class="form-row-2col">
								<label class="form-label">Husnummer</label>
								<input type="number" name="data.address.nr" min="0" max="9999" step="1" class="form-input" />
							</div>
							<div class="form-row-2col">
								<label class="form-label">Postnummer</label>
								<input type="number" name="data.address.zip" min="0" max="99999" step="1" class="form-input" />
							</div>
						</div>
					</div>

					<!-- Building Fields -->
					<div class="form node-fields node-fields-building" style="display:none">
						<div class="form-row-2col">
							<label class="form-label">Email</label>
							<input type="email" name="data.email" class="form-input" />
						</div>
						<div class="form-row-2col">
							<label class="form-label">Anvendelse</label>
							<input type="text" name="data.usage" class="form-input" />
						</div>
						<div class="form-row-2col">
							<label class="form-label">Samlet areal (m2)</label>
							<input type="number" name="data.total_area" min="0" max="10000000" step="1" class="form-input" />
						</div>
						<div class="form-row-2col">
							<label class="form-label">Opvarmet areal (m2)</label>
							<input type="number" name="data.heated_area" min="0" max="10000000" step="1" class="form-input" />
						</div>
						<div class="form-row-2col">
							<label class="form-label">BBR</label>
							<input type="text" name="data.bbr" pattern="[0-9]*" maxlength="20" class="form-input" />
						</div>
						<div class="form-row-2col">
							<label class="form-label">Byggeår</label>
							<input type="number" name="data.build_year" min="1000" max="2200" step="1" class="form-input" />
						</div>
						<div class="form-row-2col">
							<label class="form-label">P-nummer</label>
							<input type="number" name="data.p_nr" min="0" max="99999999" step="1" class="form-input" />
						</div>
						<div class="form-row-2col">
							<label class="form-label">Eksternt ID</label>
							<input type="text" name="data.ext_id" class="form-input" />
						</div>
						<div class="form-row-2col">
							<label class="form-label">Vejrstation</label>
							<input type="text" name="data.weather_station" class="form-input" />
						</div>
						<div class="form-row-2col">
							<label class="form-label">Tidszone</label>
							<select name="data.timezone" class="form-select" hx-get={`${API_BASE_URL}/hierarchy/query/timezones`} hx-request='{"noHeaders": true}' hx-trigger="intersect once" hx-params="none" hx-swap="innerHTML">
								<option value="Europe/Copenhagen" selected>Europe/Copenhagen (CET/CEST)</option>
								<option value="Europe/Stockholm">Europe/Stockholm (CET/CEST)</option>
							</select>
						</div>
						<div class="bordered-section" style="margin-top: 1rem;">
							<h3 class="section-title">Lokation</h3>
							<div class="form-row-2col">
								<label class="form-label">Breddegrad</label>
								<input type="number" step="0.000001" name="data.location.lat" min="-90" max="90" placeholder="55.6761" class="form-input" />
							</div>
							<div class="form-row-2col">
								<label class="form-label">Længdegrad</label>
								<input type="number" step="0.000001" name="data.location.long" min="-180" max="180" placeholder="12.5683" class="form-input" />
							</div>
						</div>
					</div>

					<!-- Area Fields -->
					<div class="form node-fields node-fields-area" style="display:none">
						<p style="color: var(--text-muted);">Område har ingen yderligere metadata felter</p>
					</div>

					<!-- Group Fields -->
					<div class="form node-fields node-fields-group" style="display:none">
						<p style="color: var(--text-muted);">Gruppe har ingen yderligere metadata felter</p>
					</div>
				</form>
			</div>

			<div class="dialog-footer">
				<button _="on click call #create-dialog.close()" class="btn-secondary">
					Annuller
				</button>
				<div></div>
				<button type="submit" form="create-node-form" class="btn-primary"
					@click="if (nodeType === 'company') { $event.preventDefault(); submitCompany(); }">
					Gem
				</button>
			</div>
		</dialog>

		<!-- Delete Confirmation Dialog -->
		<dialog x-ref="deleteDialog" @click.self="closeDeleteDialog()">
			<div class="dialog-header danger">
				<h2>SLET NODE</h2>
				<button @click="closeDeleteDialog()" class="btn-close danger">&times;</button>
			</div>

			<div class="dialog-body">
				<p style="margin-bottom: 1rem;">Er du sikker på, at du vil slette denne node?</p>
				<p style="font-size: var(--text-sm); color: var(--text-muted); margin-bottom: 1rem;">
					Node ID: <span style="font-family: monospace; font-weight: 600;" x-text="sessionStorage.getItem('selectedNodeId')"></span>
				</p>
				<p style="font-size: var(--text-sm); color: var(--danger); font-weight: 600;">
					Dette vil også slette alle underelementer og kan ikke fortrydes!
				</p>
			</div>

			<div class="dialog-footer">
				<button @click="closeDeleteDialog()" class="btn-secondary">
					Annuller
				</button>
				<div></div>
				<button @click="deleteNode()" class="btn-danger">
					Slet
				</button>
			</div>
		</dialog>

	</div>
</Layout>

