---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Resource Insights - Energimodel">
	<div class="page-container">

		<!-- === VIEW 1: Overview table === -->
		<div id="view-overview">
			<div class="alarm-header">
				<div>
					<h1 class="page-title">Energimodel</h1>
					<p class="alarm-subtitle">Oversigt over bygningers energimodeller</p>
				</div>
				<div class="alarm-actions">
					<button type="button" class="btn-icon" aria-label="Information om energimodel"
						_="on click remove @hidden from #info-dialog then call #info-dialog.showModal()">
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
							<circle cx="12" cy="12" r="10"/><path d="M12 16v-4m0-4h.01"/>
						</svg>
					</button>
				</div>
			</div>

			<div class="table-panel">
				<div style="overflow-x: auto;">
					<table class="data-table em-table" id="em-overview-table">
						<thead>
							<tr>
								<th style="width: 36px;">
									<input type="checkbox" class="form-checkbox" />
								</th>
								<th class="em-sortable" _="on click send sort(column:'area') to #em-overview-table">Opvarmet areal</th>
								<th class="em-sortable" _="on click send sort(column:'type') to #em-overview-table">Energimodel type</th>
								<th class="em-sortable" _="on click send sort(column:'valid') to #em-overview-table">Gyldig fra</th>
								<th class="em-sortable" _="on click send sort(column:'quality') to #em-overview-table">Kvalitet</th>
								<th class="em-sortable" _="on click send sort(column:'baseload') to #em-overview-table">Baseload daglig</th>
								<th class="em-sortable">Baseload pr. m²</th>
								<th class="em-sortable">Basistemp. varme</th>
								<th class="em-sortable">Energi pr. VGD</th>
								<th class="em-sortable">Energi pr. VGD pr. m²</th>
								<th class="em-sortable">Basistemp. køling</th>
								<th class="em-sortable">Energi pr. KGD</th>
								<th class="em-sortable">Energi pr. KGD pr. m²</th>
								<th style="width: 40px;"></th>
							</tr>
						</thead>
						<tbody>
							<tr>
								<td><input type="checkbox" class="form-checkbox" /></td>
								<td>17500 m²</td>
								<td>Hybrid</td>
								<td>01-01-2025</td>
								<td><span class="em-quality em-quality--hoj">Høj</span></td>
								<td class="em-num">6.467,51 kWh</td>
								<td class="em-num">3,80 kWh</td>
								<td class="em-temp em-temp--warm">6,0 °C</td>
								<td class="em-num">424,37 kWh</td>
								<td class="em-num">0,02 kWh</td>
								<td class="em-temp em-temp--cool">6,5 °C</td>
								<td class="em-num">52,42 kWh</td>
								<td class="em-num">0,00 kWh</td>
