---
// Datatilegnelse / measurements viewer — reached from a sensor's "…" kebab menu
// in the node sensors table ("Gå til datatilegnelse"). Mirrors the EMS
// /datasource page: a metadata section (the logical meter's identity + unit /
// purpose / type) with Fra/Til calendars, then the raw measurement readings.
//
// The sensor identity + metadata arrive as query params from the kebab link
// (daq, sid, logical, purpose, unit, type) and are bound client-side via Alpine.
//
// Measurement ROWS are representative today. They will be HTMX/fetch-loaded from
// the cross-account raw-measurements API (PUBLIC_RAW_MEASUREMENTS_API_BASE_URL,
// daq account) — see data-endpoint below. That API reads `raw_data` (Iceberg) via
// Athena, returns the newest version of each reading (max ingested_time per
// timestamp), supports a row LIMIT, and a keyset cursor (`before`) for "load more".
import Layout from "../layouts/Layout.astro";

// Representative readings (a counter odometer climbing over time). Replaced by
// the raw-measurements API response: { rows:[{timestamp,value,unit,ingested_time}], next_before }.
const rows = [
  { ts: "2026-06-25 09:00", value: "739.163,000", ingested: "2026-06-25 09:04" },
  { ts: "2026-06-25 08:00", value: "739.121,000", ingested: "2026-06-25 08:03" },
  { ts: "2026-06-25 07:00", value: "739.088,000", ingested: "2026-06-25 07:05" },
  { ts: "2026-06-25 06:00", value: "739.061,000", ingested: "2026-06-25 06:04" },
  { ts: "2026-06-25 05:00", value: "739.040,000", ingested: "2026-06-25 05:03" },
  { ts: "2026-06-25 04:00", value: "739.026,000", ingested: "2026-06-25 04:06" },
  { ts: "2026-06-25 03:00", value: "739.018,000", ingested: "2026-06-25 03:04" },
  { ts: "2026-06-25 02:00", value: "739.013,000", ingested: "2026-06-25 02:05" },
];

// The /measurements route lives on the SAME aggregations Function URL as the
// chart data (one lambda; PUBLIC_AGG_API_BASE_URL). When configured, the table
// goes live via HTMX (cross-account GET → HTML fragment); until then the
// representative rows above render so the page still looks correct. `noHeaders`
// keeps it a simple CORS GET (no preflight); daq_id comes from the URL, the rest
// from #m-controls.
// Backends for the SAME readings contract (identical HTML fragment):
//   primaryUrl  = DuckDB reader (S3 Tables) when PUBLIC_DUCK_API_BASE_URL is set, else the
//                 aggregations/Athena lambda — both at /meterdata/query/get_measurements
const duckBase = import.meta.env.PUBLIC_DUCK_API_BASE_URL || "";
const aggBase = import.meta.env.PUBLIC_AGG_API_BASE_URL || "";
const primaryBase = duckBase || aggBase;   // DuckDB is the default reader; Athena falls back
const primaryUrl = `${primaryBase}/meterdata/query/get_measurements`;
const live = primaryBase !== "";
const hxBase = primaryUrl;

// htmx caches an element's hx-get at process time, so we can't swap backends by
// mutating the attribute — instead the buttons/checkbox issue an explicit
// htmx.ajax() to the chosen full URL. `source:#m-rows` pulls hx-include (#m-controls,
// which carries daq_id/from/to/limit/before) so params are identical either way.
const pickUrl = `set url to '${primaryUrl}'`;
const ajaxReplace = `call window.htmx.ajax('GET', url, {source:'#m-rows', target:'#m-rows', swap:'innerHTML'})`;
const ajaxAppend = `call window.htmx.ajax('GET', url, {source:'#m-rows', target:'#m-rows', swap:'beforeend'})`;
const opdaterScript = `on click\n set #m-before.value to ''\n ${pickUrl}\n ${ajaxReplace}`;
// Infinite scroll: when the bottom sentinel scrolls into view, append the next
// page — but only while there's a cursor (#m-before non-empty; the backend clears
// it when the last page wasn't full) and not already loading (data-busy guard,
// cleared on the response). Reuses the same cursor + append the button used.
const infScrollScript = `on intersection(intersecting)
  if intersecting and #m-before.value is not '' and @data-busy is not '1'
    set @data-busy to '1'
    ${pickUrl}
    ${ajaxAppend}
  end
end
on htmx:afterOnLoad from #m-rows set @data-busy to '0'`;
---
<Layout title="Datatilegnelse">
  <div class="page-container" x-data="{ q: new URLSearchParams(location.search), to: new Date(Date.now() - new Date().getTimezoneOffset()*6e4).toISOString().slice(0,10), from: new Date(Date.now() - new Date().getTimezoneOffset()*6e4 - 864e5).toISOString().slice(0,10) }">
    <!-- Header: meter identity from the kebab link -->
    <div class="view-header">
      <div>
        <h1 class="page-title">
          <span data-i18n="measurements.title">Datatilegnelse</span>
          <span class="muted">—</span>
          <span x-text="q.get('purpose') || '—'"></span>
        </h1>
        <p class="page-description">
          <span data-i18n="measurements.subtitle">Rå måleraflæsninger for den valgte sensor.</span>
        </p>
      </div>
      <div class="view-actions">
        <a href="javascript:history.back()" class="btn-secondary" data-i18n="common.close">Luk</a>
      </div>
    </div>

    <!-- Metadata section: the logical meter id + its metadata -->
    <section class="card">
      <div class="section-header">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 7V4h16v3"/><path d="M9 20h6"/><path d="M12 4v16"/></svg>
        <h2 class="section-title" style="margin-bottom:0" data-i18n="measurements.metadata">Metadata</h2>
        <span class="badge" style="margin-left:auto" x-text="(q.get('type')||'—')"></span>
      </div>
      <dl class="meta-grid">
        <div><dt data-i18n="measurements.logical_id">Logisk måler-id</dt><dd x-text="q.get('logical') || '—'"></dd></div>
        <div><dt data-i18n="measurements.sensor_id">Sensor-id</dt><dd x-text="q.get('sid') || '—'"></dd></div>
        <div><dt>DAQ ID</dt><dd class="mono" x-text="q.get('daq') || '—'"></dd></div>
        <div><dt data-i18n="common.purpose">Formål</dt><dd x-text="q.get('purpose') || '—'"></dd></div>
        <div><dt data-i18n="common.unit">Enhed</dt><dd x-text="q.get('unit') || '—'"></dd></div>
        <div><dt data-i18n="measurements.type">Type</dt><dd x-text="q.get('type') || '—'"></dd></div>
      </dl>
    </section>

    <!-- Filter bar: from / to calendars + row limit. #m-controls is hx-included
         on the live requests; #m-before is the keyset cursor (OOB-updated). -->
    <div class="filter-bar" id="m-controls">
      <div class="filter-field">
        <label class="form-label" data-i18n="measurements.from">Fra</label>
        <input type="date" class="form-input" name="from" x-model="from" />
      </div>
      <div class="filter-field">
        <label class="form-label" data-i18n="measurements.to">Til</label>
        <input type="date" class="form-input" name="to" x-model="to" />
      </div>
      <div class="filter-field">
        <label class="form-label" data-i18n="measurements.rows">Antal rækker</label>
        <select class="form-select" name="limit">
          <option>100</option><option>250</option><option>500</option>
        </select>
      </div>
      <div class="filter-field filter-field--action">
        <button type="button" class="btn-primary" data-i18n="common.apply"
          {...(live ? { "_": opdaterScript } : {})}>Opdater</button>
      </div>
      <input type="hidden" name="daq_id" x-bind:value="q.get('daq') || ''" />
      <input type="hidden" id="m-before" name="before" value="" />
    </div>

    <!-- Measurement readings. data-endpoint carries the future contract:
         GET <PUBLIC_RAW_MEASUREMENTS_API_BASE_URL>/measurements
             ?daq_id=<daq>&from=<iso>&to=<iso>&limit=<n>&before=<cursor> -->
    <div class="table-panel" data-endpoint="/measurements"
         data-endpoint-params="daq_id,from,to,limit,before">
      <!-- Loading indicator (htmx-indicator): shown whenever a request that names
           it is in flight — initial load, Opdater, and infinite-scroll appends. -->
      <div id="m-spinner" class="htmx-indicator m-loading" role="status" aria-live="polite">
        <span class="m-spin" aria-hidden="true"></span>
        <span data-i18n="measurements.loading">Henter måledata fra Athena…</span>
      </div>
      <table class="data-table">
        <thead>
          <tr>
            <th data-i18n="measurements.date">Dato</th>
            <th style="text-align:right" data-i18n="measurements.reading">Aflæsning</th>
            <th data-i18n="common.unit">Enhed</th>
            <th data-i18n="measurements.ingested">Indlæst (version)</th>
          </tr>
        </thead>
        {live ? (
          <tbody id="m-rows"
            hx-get={hxBase}
            hx-trigger="mready"
            hx-include="#m-controls"
            hx-swap="innerHTML"
            hx-indicator="#m-spinner"
            hx-request='{"noHeaders":true}'>
            <tr><td colspan="4" class="muted">Indlæser…</td></tr>
          </tbody>
        ) : (
          <tbody id="m-rows">
            {rows.map((r) => (
              <tr>
                <td class="mono">{r.ts}</td>
                <td class="mono" style="text-align:right">{r.value}</td>
                <td><span x-text="q.get('unit') || ''"></span></td>
                <td class="mono muted">{r.ingested}</td>
              </tr>
            ))}
          </tbody>
        )}
      </table>
      <div class="table-foot">
        <span class="muted" data-i18n="measurements.dedup_note">Viser nyeste version af hver aflæsning (max. ingested_time).</span>
        {live && (
          <div id="m-sentinel" data-busy="0" class="m-sentinel" {...{ "_": infScrollScript }}>
            <span class="m-spin" aria-hidden="true"></span>
            <span class="muted" data-i18n="measurements.loading_more">Indlæser flere…</span>
          </div>
        )}
      </div>
    </div>
  </div>
</Layout>

<style>
  .meta-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px 24px;
    margin: 0;
  }
  .meta-grid > div { display: grid; gap: 2px; }
  .meta-grid dt { font-size: var(--text-xs); color: var(--text-muted); }
  .meta-grid dd { margin: 0; font-variant-numeric: tabular-nums; }
  .mono { font-family: ui-monospace, "SFMono-Regular", Menlo, monospace; font-size: var(--text-sm); }
  .filter-field--action { align-self: end; }
  .table-foot {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 12px;
    padding: 12px;
    border-top: 1px solid var(--border-medium);
  }
  @media (max-width: 760px) { .meta-grid { grid-template-columns: 1fr 1fr; } }
</style>

<script>
  // This page reads its identity (daq/purpose/…) from the URL. Under a soft
  // (Astro view-transition) navigation the DOM + htmx run *before* the URL
  // settles, so params come up blank. Drive the param-read and the data load
  // off astro:page-load, which fires AFTER the URL is set — on both hard loads
  // and soft navigations — so /measurements works either way and no navigation
  // needs a full page reload (keeping the sidebar/tree intact).
  function loadMeasurements() {
    if (!document.querySelector('[data-endpoint="/measurements"]')) return; // not this page
    let tries = 0;
    const iv = setInterval(() => {
      const el = document.querySelector(".page-container");
      const stack = el && el._x_dataStack;
      if (stack && stack[0]) {
        stack[0].q = new URLSearchParams(location.search); // refresh Alpine bindings
        clearInterval(iv);
        // A soft nav doesn't htmx-process this page (Layout only processes the
        // node panel), so process it here, then fire the load once Alpine has
        // flushed the daq_id binding.
        if (window.htmx) window.htmx.process(el);
        const rows = document.getElementById("m-rows");
        requestAnimationFrame(() => {
          if (rows && window.htmx) window.htmx.trigger(rows, "mready");
        });
      } else if (++tries > 40) {
        clearInterval(iv); // Alpine never mounted — give up quietly
      }
    }, 25);
  }
  document.addEventListener("astro:page-load", loadMeasurements);
</script>

<!-- Global: htmx toggles `.htmx-request` at runtime, so these can't be Astro-scoped. -->
<style is:global>
  .m-loading { display: flex; align-items: center; gap: 8px; color: var(--text-muted); font-size: 0.85rem; }
  /* The indicator collapses to nothing when idle, expands only while loading. */
  .htmx-indicator { opacity: 0; height: 0; padding: 0 !important; overflow: hidden; transition: opacity 120ms ease-in; }
  .htmx-request.htmx-indicator { opacity: 1; height: auto; padding: 10px 12px !important; }
  .m-sentinel { display: flex; align-items: center; gap: 8px; min-height: 1px; opacity: 0; transition: opacity 120ms; font-size: 0.85rem; }
  .m-sentinel[data-busy="1"] { opacity: 1; }
  .m-spin {
    display: inline-block; width: 14px; height: 14px; border-radius: 50%;
    border: 2px solid var(--border-medium, #d7dde3);
    border-top-color: var(--accent, #1f9e8f);
    animation: m-spin 0.7s linear infinite;
  }
  @keyframes m-spin { to { transform: rotate(360deg); } }
</style>
