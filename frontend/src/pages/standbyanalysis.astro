					EL
				</button>
				<button type="button" class="energy-tab" data-energy="varme"
					_="on click remove .active from .energy-tab then add .active to me">
					<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2c-5.33 4-8 7.33-8 10a8 8 0 0016 0c0-2.67-2.67-6-8-10z"/></svg>
					Varme
				</button>
				<button type="button" class="energy-tab" data-energy="vand"
					_="on click remove .active from .energy-tab then add .active to me">
					<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2c-5.33 4-8 7.33-8 10a8 8 0 0016 0c0-2.67-2.67-6-8-10z"/></svg>
					Vand
