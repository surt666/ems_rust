---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Standbyanalyse">
	<div class="page-container">

		<!-- ===== LIST VIEW ===== -->
		<div id="standby-list-view">
			<div class="standby-header">
				<h1 class="page-title" data-i18n="nav.standby_analysis">Standbyanalyse</h1>
			</div>

			<!-- Filters -->
			<details class="standby-filters" open>
				<summary class="standby-filters-toggle">
					<svg class="standby-chevron-icon" width="12" height="12" viewBox="0 0 320 512" fill="currentColor">
						<path d="M299.3 244.7c6.2 6.2 6.2 16.4 0 22.6l-192 192c-6.2 6.2-16.4 6.2-22.6 0s-6.2-16.4 0-22.6L265.4 256 84.7 75.3c-6.2-6.2-6.2-16.4 0-22.6s16.4-6.2 22.6 0l192 192z"/>
					</svg>
					<span data-i18n="common.filters">Filtre</span>
				</summary>
				<div class="standby-filter-content">
					<div class="standby-filter-row">
						<div class="form-field">
							<label class="form-label" data-i18n="standby.period">Periode</label>
							<div class="standby-date-range">
								<input type="text" class="form-input" value="30-12-2024 - 26-01-2025" readonly />
								<button type="button" class="btn-icon btn-icon--sm" aria-label="Vælg dato">
									<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
								</button>
							</div>
						</div>
						<div class="standby-view-toggle">
							<label class="form-label" data-i18n="standby.choose_view">Vælg visning</label>
							<div class="toggle-group">
								<button type="button" class="toggle-btn active" data-view="cost" _="on click add .active to me remove .active from .toggle-btn in my parentElement then add .active to me">Omkostning</button>
								<button type="button" class="toggle-btn" data-view="energy" _="on click remove .active from .toggle-btn in my parentElement then add .active to me">Energi</button>
								<button type="button" class="toggle-btn" data-view="co2" _="on click remove .active from .toggle-btn in my parentElement then add .active to me">CO₂</button>
							</div>
						</div>
					</div>
					<div class="standby-filter-row">
						<div class="form-field">
							<label class="form-label" data-i18n="standby.building_usage">Bygningsanvendelse</label>
							<div class="standby-multiselect">
								<span class="multiselect-text">Bygning til detailhandel (8), Stuehus til landbrugseje... </span>
								<span class="multiselect-badge">+ 1 bygningsanvendelser</span>
							</div>
						</div>
						<div class="standby-filter-actions-row">
							<span class="standby-deselect-link" data-i18n="standby.deselect_all">Fravælg alle</span>
							<div class="form-field">
								<label class="form-label" data-i18n="standby.building_classes">Bygningsklasser</label>
								<div class="standby-multiselect">
									<span class="multiselect-text">0 (1), A2015 (1), A2010 (1),</span>
									<span class="multiselect-badge">+ 4 bygningsklasser valgt</span>
								</div>
							</div>
						</div>
						<div class="standby-filter-actions-row">
							<span class="standby-deselect-link" data-i18n="standby.deselect_all">Fravælg alle</span>
							<div class="form-field">
								<label class="form-label" data-i18n="common.building">Bygninger</label>
								<div class="standby-multiselect">
									<span class="multiselect-text">Esbjerg, Farum, Frederiksberg, Byg. B,</span>
									<span class="multiselect-badge">+ 10 bygninger valgt</span>
								</div>
							</div>
						</div>
					</div>
					<div class="standby-filter-row" style="justify-content: flex-end; gap: 8px;">
						<button type="button" class="btn-secondary" data-i18n="standby.reset_filters">Nulstil filtre</button>
					</div>
				</div>
			</details>

			<!-- Energy type tabs -->
			<div class="standby-energy-tabs">
				<button type="button" class="energy-tab active" data-energy="el"
					_="on click remove .active from .energy-tab then add .active to me">
