							<td>
								<button type="button" class="btn-analyze" _="on click add .view-hidden to #standby-list-view remove .view-hidden from #standby-detail-view then js setTimeout(() => window.dispatchEvent(new Event('resize')), 100) end set #detail-building.textContent to 'Odense afdeling'">Analyser</button>
