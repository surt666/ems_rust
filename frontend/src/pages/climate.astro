---
import Layout from '../layouts/Layout.astro';
import FilterOverlay from '../components/FilterOverlay.astro';
import Chart from '../components/Chart.astro';

// Per-category emissions, split by scope — vertical stacked columns.
const emissionCategories = ['El', 'Fjernvarme', 'Naturgas', 'Vand', 'Transport'];
const emissionScopes = [
  { name: 'Scope 1', data: [0, 0, 125, 0, 0], color: '#f97316', type: 'bar' as const },
  { name: 'Scope 2', data: [312, 435, 0, 0, 0], color: '#2dd4bf', type: 'bar' as const },
  { name: 'Scope 3', data: [23, 155, 68, 45, 84], color: '#38bdf8', type: 'bar' as const },
];
---
<Layout title="Klimaregnskab">
	<div class="page-container">

		<!-- Header -->
		<div class="climate-header">
			<h1 class="page-title" data-i18n="nav.climate">Klimaregnskab</h1>
			<div class="climate-controls">
				<select class="form-select climate-basis-select">
					<option>Lokationsbaseret</option>
					<option>Markedsbaseret</option>
				</select>
				<div class="climate-date-range">
					<input type="text" class="form-input" value="01-01-2026 - 31-12-2026" readonly />
					<button type="button" class="btn-icon btn-icon--sm">
						<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
					</button>
				</div>
				<FilterOverlay triggerLabel="Bygningsfiltre" title="Bygningsfiltre">
					<div class="filter-overlay__group">
						<span class="filter-overlay__group-title">Bygningsfiltre</span>
						<div class="form-field">
							<label class="form-label">Bygningsanvendelse</label>
							<select class="form-select"><option>Alle (6)</option></select>
						</div>
						<div class="form-field">
							<label class="form-label">Bygninger</label>
							<select class="form-select"><option>Alle (16)</option></select>
						</div>
					</div>
					<button slot="actions" type="button" class="btn-secondary">Nulstil filtre</button>
					<button slot="actions" type="button" class="btn-primary">Hent klimaregnskab</button>
				</FilterOverlay>
				<button type="button" class="btn-primary">Rapporter</button>
			</div>
		</div>

		<!-- Top row: Donut chart + Bar chart -->
		<div class="climate-top-grid">

			<!-- Donut chart: Total emissions by scope -->
			<div class="card climate-donut-card">
				<h3 class="climate-card-title">Udledning fordelt på scopes</h3>
				<div class="climate-donut-container">
					<svg viewBox="0 0 200 200" class="climate-donut">
						<!-- Scope 2 (largest) -->
						<circle cx="100" cy="100" r="80" fill="none" stroke="#2dd4bf" stroke-width="24"
							stroke-dasharray="326 503" stroke-dashoffset="-126" />
						<!-- Scope 3 -->
						<circle cx="100" cy="100" r="80" fill="none" stroke="#38bdf8" stroke-width="24"
							stroke-dasharray="126 503" stroke-dashoffset="0" />
						<!-- Scope 1 -->
						<circle cx="100" cy="100" r="80" fill="none" stroke="#f97316" stroke-width="24"
							stroke-dasharray="51 503" stroke-dashoffset="-452" />
						<!-- Center text -->
						<text x="100" y="92" text-anchor="middle" fill="var(--text-primary)" font-size="20" font-weight="700">1.247</text>
						<text x="100" y="112" text-anchor="middle" fill="var(--text-muted)" font-size="10">t CO₂e</text>
					</svg>
					<div class="climate-donut-legend">
						<div class="climate-legend-item">
							<span class="legend-dot" style="background: #f97316;"></span>
							<span class="legend-label">Scope 1</span>
							<span class="legend-value">125 t CO₂e</span>
						</div>
						<div class="climate-legend-item">
							<span class="legend-dot" style="background: #2dd4bf;"></span>
							<span class="legend-label">Scope 2</span>
							<span class="legend-value">747 t CO₂e</span>
						</div>
						<div class="climate-legend-item">
							<span class="legend-dot" style="background: #38bdf8;"></span>
							<span class="legend-label">Scope 3</span>
							<span class="legend-value">375 t CO₂e</span>
						</div>
					</div>
				</div>
			</div>

			<!-- Bar chart: Emissions by type — vertical stacked columns (Scope 1/2/3;
			     toggle scopes via the chart legend) -->
			<div class="card climate-bar-card">
				<div class="climate-bar-header">
					<h3 class="climate-card-title">Udledning pr. forbrugstype</h3>
				</div>
				<div class="climate-bar-chart">
					<Chart height={300} stacked={true} zoom={false}
						unit="t CO₂e" categories={emissionCategories} series={emissionScopes} />
				</div>
			</div>
		</div>

		<!-- Scope contribution cards -->
		<div class="climate-scope-cards">
			<div class="card climate-scope-card">
				<div class="climate-scope-card-header">
					<span class="climate-scope-badge" style="background: #f97316;">Scope 1</span>
					<span class="climate-scope-total">125 t CO₂e</span>
				</div>
				<p class="climate-scope-desc">Direkte udledning fra egne kilder</p>
				<div class="climate-scope-items">
					<div class="climate-scope-item">
						<svg class="climate-scope-ring" viewBox="0 0 36 36">
							<circle cx="18" cy="18" r="15.9" fill="none" stroke="var(--border-medium)" stroke-width="3"/>
							<circle cx="18" cy="18" r="15.9" fill="none" stroke="#f97316" stroke-width="3"
								stroke-dasharray="100 100" stroke-dashoffset="0" transform="rotate(-90 18 18)"/>
							<text x="18" y="21" text-anchor="middle" fill="var(--text-primary)" font-size="8" font-weight="600">100%</text>
						</svg>
						<span class="climate-scope-item-label">Naturgas</span>
						<span class="climate-scope-item-value">125 t</span>
					</div>
				</div>
			</div>
			<div class="card climate-scope-card">
				<div class="climate-scope-card-header">
					<span class="climate-scope-badge" style="background: #2dd4bf;">Scope 2</span>
					<span class="climate-scope-total">747 t CO₂e</span>
				</div>
				<p class="climate-scope-desc">Indirekte udledning fra energiforbrug</p>
				<div class="climate-scope-items">
					<div class="climate-scope-item">
						<svg class="climate-scope-ring" viewBox="0 0 36 36">
							<circle cx="18" cy="18" r="15.9" fill="none" stroke="var(--border-medium)" stroke-width="3"/>
							<circle cx="18" cy="18" r="15.9" fill="none" stroke="#2dd4bf" stroke-width="3"
								stroke-dasharray="42 100" stroke-dashoffset="0" transform="rotate(-90 18 18)"/>
							<text x="18" y="21" text-anchor="middle" fill="var(--text-primary)" font-size="8" font-weight="600">42%</text>
						</svg>
						<span class="climate-scope-item-label">El</span>
						<span class="climate-scope-item-value">312 t</span>
					</div>
					<div class="climate-scope-item">
						<svg class="climate-scope-ring" viewBox="0 0 36 36">
							<circle cx="18" cy="18" r="15.9" fill="none" stroke="var(--border-medium)" stroke-width="3"/>
							<circle cx="18" cy="18" r="15.9" fill="none" stroke="#2dd4bf" stroke-width="3"
								stroke-dasharray="58 100" stroke-dashoffset="0" transform="rotate(-90 18 18)"/>
							<text x="18" y="21" text-anchor="middle" fill="var(--text-primary)" font-size="8" font-weight="600">58%</text>
						</svg>
						<span class="climate-scope-item-label">Fjernvarme</span>
						<span class="climate-scope-item-value">435 t</span>
					</div>
				</div>
			</div>
			<div class="card climate-scope-card">
				<div class="climate-scope-card-header">
					<span class="climate-scope-badge" style="background: #38bdf8;">Scope 3</span>
					<span class="climate-scope-total">375 t CO₂e</span>
				</div>
				<p class="climate-scope-desc">Andre indirekte udledninger</p>
				<div class="climate-scope-items">
					<div class="climate-scope-item">
						<svg class="climate-scope-ring" viewBox="0 0 36 36">
							<circle cx="18" cy="18" r="15.9" fill="none" stroke="var(--border-medium)" stroke-width="3"/>
							<circle cx="18" cy="18" r="15.9" fill="none" stroke="#38bdf8" stroke-width="3"
								stroke-dasharray="41 100" stroke-dashoffset="0" transform="rotate(-90 18 18)"/>
							<text x="18" y="21" text-anchor="middle" fill="var(--text-primary)" font-size="8" font-weight="600">41%</text>
						</svg>
						<span class="climate-scope-item-label">Fjernvarme</span>
						<span class="climate-scope-item-value">155 t</span>
					</div>
					<div class="climate-scope-item">
						<svg class="climate-scope-ring" viewBox="0 0 36 36">
							<circle cx="18" cy="18" r="15.9" fill="none" stroke="var(--border-medium)" stroke-width="3"/>
							<circle cx="18" cy="18" r="15.9" fill="none" stroke="#38bdf8" stroke-width="3"
								stroke-dasharray="22 100" stroke-dashoffset="0" transform="rotate(-90 18 18)"/>
							<text x="18" y="21" text-anchor="middle" fill="var(--text-primary)" font-size="8" font-weight="600">22%</text>
						</svg>
						<span class="climate-scope-item-label">Transport</span>
						<span class="climate-scope-item-value">84 t</span>
					</div>
					<div class="climate-scope-item">
						<svg class="climate-scope-ring" viewBox="0 0 36 36">
							<circle cx="18" cy="18" r="15.9" fill="none" stroke="var(--border-medium)" stroke-width="3"/>
							<circle cx="18" cy="18" r="15.9" fill="none" stroke="#38bdf8" stroke-width="3"
								stroke-dasharray="18 100" stroke-dashoffset="0" transform="rotate(-90 18 18)"/>
							<text x="18" y="21" text-anchor="middle" fill="var(--text-primary)" font-size="8" font-weight="600">18%</text>
						</svg>
						<span class="climate-scope-item-label">Naturgas</span>
						<span class="climate-scope-item-value">68 t</span>
					</div>
					<div class="climate-scope-item">
						<svg class="climate-scope-ring" viewBox="0 0 36 36">
							<circle cx="18" cy="18" r="15.9" fill="none" stroke="var(--border-medium)" stroke-width="3"/>
							<circle cx="18" cy="18" r="15.9" fill="none" stroke="#38bdf8" stroke-width="3"
								stroke-dasharray="12 100" stroke-dashoffset="0" transform="rotate(-90 18 18)"/>
							<text x="18" y="21" text-anchor="middle" fill="var(--text-primary)" font-size="8" font-weight="600">12%</text>
						</svg>
						<span class="climate-scope-item-label">Vand</span>
						<span class="climate-scope-item-value">45 t</span>
					</div>
					<div class="climate-scope-item">
						<svg class="climate-scope-ring" viewBox="0 0 36 36">
							<circle cx="18" cy="18" r="15.9" fill="none" stroke="var(--border-medium)" stroke-width="3"/>
							<circle cx="18" cy="18" r="15.9" fill="none" stroke="#38bdf8" stroke-width="3"
								stroke-dasharray="6 100" stroke-dashoffset="0" transform="rotate(-90 18 18)"/>
							<text x="18" y="21" text-anchor="middle" fill="var(--text-primary)" font-size="8" font-weight="600">6%</text>
						</svg>
						<span class="climate-scope-item-label">El</span>
						<span class="climate-scope-item-value">23 t</span>
					</div>
				</div>
			</div>
		</div>

		<!-- Buildings emissions table -->
		<div class="climate-table-section">
			<div class="climate-table-header">
				<h3 class="climate-card-title">Emissionsopgørelse</h3>
				<div class="climate-table-toggles">
					<button type="button" class="toggle-btn active" _="on click remove .active from .climate-view-btn then add .active to me">Scopes</button>
					<button type="button" class="toggle-btn climate-view-btn" _="on click remove .active from .climate-view-btn then add .active to me">Bygninger</button>
				</div>
			</div>
			<div class="table-panel">
				<table class="data-table">
					<thead>
						<tr>
							<th>Bygning</th>
							<th>Scope 1</th>
							<th>Scope 2</th>
							<th>Scope 3</th>
							<th>Total</th>
							<th style="width: 40px;"></th>
						</tr>
					</thead>
					<tbody>
						<tr>
							<td>Administrationsbygning</td>
							<td>42 t CO₂e</td>
							<td>285 t CO₂e</td>
							<td>134 t CO₂e</td>
							<td class="climate-total-cell">461 t CO₂e</td>
							<td>
								<details class="dropdown">
									<summary class="btn-icon btn-icon--sm" aria-label="Handlinger">
										<svg width="14" height="14" fill="currentColor" viewBox="0 0 16 16"><circle cx="3" cy="8" r="1.5"/><circle cx="8" cy="8" r="1.5"/><circle cx="13" cy="8" r="1.5"/></svg>
									</summary>
									<div class="dropdown-menu">
										<button type="button" class="dropdown-item">Gå til forbrug</button>
										<button type="button" class="dropdown-item">Vis emissionstyper</button>
									</div>
								</details>
							</td>
						</tr>
						<tr>
							<td>Byg. B</td>
							<td>28 t CO₂e</td>
							<td>198 t CO₂e</td>
							<td>95 t CO₂e</td>
							<td class="climate-total-cell">321 t CO₂e</td>
							<td>
								<details class="dropdown">
									<summary class="btn-icon btn-icon--sm" aria-label="Handlinger">
										<svg width="14" height="14" fill="currentColor" viewBox="0 0 16 16"><circle cx="3" cy="8" r="1.5"/><circle cx="8" cy="8" r="1.5"/><circle cx="13" cy="8" r="1.5"/></svg>
									</summary>
									<div class="dropdown-menu">
										<button type="button" class="dropdown-item">Gå til forbrug</button>
										<button type="button" class="dropdown-item">Vis emissionstyper</button>
									</div>
								</details>
							</td>
						</tr>
						<tr>
							<td>Horsens</td>
							<td>31 t CO₂e</td>
							<td>152 t CO₂e</td>
							<td>87 t CO₂e</td>
							<td class="climate-total-cell">270 t CO₂e</td>
							<td>
								<details class="dropdown">
									<summary class="btn-icon btn-icon--sm" aria-label="Handlinger">
										<svg width="14" height="14" fill="currentColor" viewBox="0 0 16 16"><circle cx="3" cy="8" r="1.5"/><circle cx="8" cy="8" r="1.5"/><circle cx="13" cy="8" r="1.5"/></svg>
									</summary>
									<div class="dropdown-menu">
										<button type="button" class="dropdown-item">Gå til forbrug</button>
										<button type="button" class="dropdown-item">Vis emissionstyper</button>
									</div>
								</details>
							</td>
						</tr>
						<tr>
							<td>Esbjerg</td>
							<td>24 t CO₂e</td>
							<td>112 t CO₂e</td>
							<td>59 t CO₂e</td>
							<td class="climate-total-cell">195 t CO₂e</td>
							<td>
								<details class="dropdown">
									<summary class="btn-icon btn-icon--sm" aria-label="Handlinger">
										<svg width="14" height="14" fill="currentColor" viewBox="0 0 16 16"><circle cx="3" cy="8" r="1.5"/><circle cx="8" cy="8" r="1.5"/><circle cx="13" cy="8" r="1.5"/></svg>
									</summary>
									<div class="dropdown-menu">
										<button type="button" class="dropdown-item">Gå til forbrug</button>
										<button type="button" class="dropdown-item">Vis emissionstyper</button>
									</div>
								</details>
							</td>
						</tr>
					</tbody>
					<tfoot>
						<tr class="climate-total-row">
							<td><strong>Total</strong></td>
							<td><strong>125 t CO₂e</strong></td>
							<td><strong>747 t CO₂e</strong></td>
							<td><strong>375 t CO₂e</strong></td>
							<td class="climate-total-cell"><strong>1.247 t CO₂e</strong></td>
							<td></td>
						</tr>
					</tfoot>
				</table>
			</div>
		</div>
	</div>
</Layout>
