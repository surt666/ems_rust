---
interface Props {
        title: string;
}

const { title } = Astro.props;

import { ClientRouter } from "astro:transitions";
import Navbar from "../components/Navbar.astro";
import Hierarchy from "../components/Hierarchy.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import SchemaDesigner from "../components/SchemaDesigner.astro";

// base.css is served from public/ at the stable URL /base.css (linked in <head> below)
// so independent microfrontends can share the exact same design-system base — single
// source of truth, no copy. global/enity remain bundled component styles.
import "../styles/global.css";
import "../styles/enity-theme.css";

---

<!doctype html>
<html lang="da">
        <head>
                <meta charset="UTF-8" />
                <!-- Shared design-system base (element defaults) — single source of truth,
                     served from public/ so microfrontends can link the same file. Loaded
                     first so component classes (global/enity) override where needed. -->
                <link rel="stylesheet" href="/base.css" />
                <meta name="description" content="EMS - Energy Management System" />
                <meta name="viewport" content="width=device-width" />
                <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
                <link rel="preconnect" href="https://fonts.googleapis.com" />
                <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
                <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Source+Sans+Pro:ital,wght@0,400;0,600;0,700;1,400&display=swap" />
                <meta name="generator" content={Astro.generator} />
                <title>{title}</title>
                <ClientRouter />
        </head>
        <body class="app-layout">

          <svg style="display: none;">
            <!-- Chevron arrow for expandable nodes -->
            <symbol id="chevron-right" viewBox="0 0 320 512">
              <path fill="currentColor" d="M299.3 244.7c6.2 6.2 6.2 16.4 0 22.6l-192 192c-6.2 6.2-16.4 6.2-22.6 0s-6.2-16.4 0-22.6L265.4 256 84.7 75.3c-6.2-6.2-6.2-16.4 0-22.6s16.4-6.2 22.6 0l192 192z"></path>
            </symbol>

            <!-- Partner: globe with meridian lines -->
            <symbol id="icon-partner" viewBox="0 0 512 512">
