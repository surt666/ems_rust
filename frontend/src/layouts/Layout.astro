            </symbol>

            <!-- Area: grid/sections -->
            <symbol id="icon-area" viewBox="0 0 448 512">
              <path fill="currentColor" d="M0 72C0 49.9 17.9 32 40 32l48 0c22.1 0 40 17.9 40 40l0 48c0 22.1-17.9 40-40 40l-48 0C17.9 200 0 182.1 0 160L0 72zM0 232c0-22.1 17.9-40 40-40l48 0c22.1 0 40 17.9 40 40l0 48c0 22.1-17.9 40-40 40l-48 0c-22.1 0-40-17.9-40-40l0-48zM128 392l0 48c0 22.1-17.9 40-40 40l-48 0c-22.1 0-40-17.9-40-40l0-48c0-22.1 17.9-40 40-40l48 0c22.1 0 40 17.9 40 40zM160 72c0-22.1 17.9-40 40-40l48 0c22.1 0 40 17.9 40 40l0 48c0 22.1-17.9 40-40 40l-48 0c-22.1 0-40-17.9-40-40l0-48zM288 232l0 48c0 22.1-17.9 40-40 40l-48 0c-22.1 0-40-17.9-40-40l0-48c0-22.1 17.9-40 40-40l48 0c22.1 0 40 17.9 40 40zM160 392c0-22.1 17.9-40 40-40l48 0c22.1 0 40 17.9 40 40l0 48c0 22.1-17.9 40-40 40l-48 0c-22.1 0-40-17.9-40-40l0-48zM448 72l0 48c0 22.1-17.9 40-40 40l-48 0c-22.1 0-40-17.9-40-40l0-48c0-22.1 17.9-40 40-40l48 0c22.1 0 40 17.9 40 40zM320 232c0-22.1 17.9-40 40-40l48 0c22.1 0 40 17.9 40 40l0 48c0 22.1-17.9 40-40 40l-48 0c-22.1 0-40-17.9-40-40l0-48zM448 392l0 48c0 22.1-17.9 40-40 40l-48 0c-22.1 0-40-17.9-40-40l0-48c0-22.1 17.9-40 40-40l48 0c22.1 0 40 17.9 40 40z"/>
            </symbol>

            <!-- Group: folder -->
            <symbol id="icon-group" viewBox="0 0 512 512">
              <path fill="currentColor" d="M64 480H448c35.3 0 64-28.7 64-64V160c0-35.3-28.7-64-64-64H288c-10.1 0-19.6-4.7-25.6-12.8L243.2 57.6C231.1 41.5 212.1 32 192 32H64C28.7 32 0 60.7 0 96V416c0 35.3 28.7 64 64 64z"/>
            </symbol>
          </svg>

          <a href="/" class="brand" aria-label="Enity EMS">
            <img class="brand-logo" src="/images/logo-app-topleft.svg" alt="Enity EMS" width="132" height="26" />
          </a>

          <header class="top-nav">
            <Navbar />
          </header>

          <nav class="breadcrumb-nav">
            <Breadcrumb />
          </nav>

          <aside class="sidebar" transition:persist="side-menu">
            <Hierarchy />
          </aside>

          <main class="main-content main-area">
            <slot />
          </main>

          <!-- Shared hierarchy-schema designer dialog (opened from the add-child
               form when creating a company). The listener below writes its
               serialised schema into the add-child form's hidden field. -->
          <SchemaDesigner />
        </body>
</html>

<script is:inline>
  window.addEventListener("schema-updated", (e) => {
    const field = document.getElementById("add-child-schema-json");
    if (field) field.value = JSON.stringify(e.detail.schema);
    const status = document.getElementById("add-child-schema-status");
    if (status) status.textContent = "✓ skema defineret";
  });
</script>

<script>
	import 'invokers/compatible';
	import { signOut } from 'aws-amplify/auth';
	import { navigate } from 'astro:transitions/client';
	import { configureAmplify } from '../lib/amplify-config';
	import { applyTranslations } from '../lib/i18n';

	// Expose Astro's view-transition navigate so the hierarchy dropdowns can jump
	// to /node the same (no-full-reload) way clicking a tree node name does.
	window.emsNavigate = navigate;

	configureAmplify();

	function setupLogout() {
		document.getElementById('logout-btn')?.addEventListener('click', async () => {
			try {
				await signOut();
			} catch (error) {
				console.log('Logout error:', error.message);
			}
			window.location.href = '/';
		});
	}

	setupLogout();
	applyTranslations();

	document.addEventListener('astro:page-load', () => {
		setupLogout();
		applyTranslations();
	});

	// Re-translate any HTMX-swapped fragment.
	document.body.addEventListener('htmx:afterSwap', () => applyTranslations());

	// View transitions don't auto-process HTMX. After a transition swaps in the
	// /node page, (re)process its node panel so hx-trigger="load" fires and the
	// node detail loads. (after-swap fires on transitions only, not initial load,
	// where htmx already processes on DOMContentLoaded — so no double fetch.)
	document.addEventListener('astro:after-swap', () => {
		const panel = document.getElementById('node-data-panel');
		if (panel && window.htmx) window.htmx.process(panel);
	});
</script>
