---
interface Props {
        title: string;
}

const { title } = Astro.props;

import { ClientRouter } from "astro:transitions";
import Navbar from "../components/Navbar.astro";
import Hierarchy from "../components/Hierarchy.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import SchemaDesigner from "../components/SchemaDesigner.astro";

// base.css is served from public/ at the stable URL /base.css (linked in <head> below)
// so independent microfrontends can share the exact same design-system base — single
// source of truth, no copy. global/enity remain bundled component styles.
import "../styles/global.css";
import "../styles/enity-theme.css";

---

<!doctype html>
<html lang="da">
        <head>
                <meta charset="UTF-8" />
                <!-- Shared design-system base (element defaults) — single source of truth,
                     served from public/ so microfrontends can link the same file. Loaded
                     first so component classes (global/enity) override where needed. -->
                <link rel="stylesheet" href="/base.css" />
                <meta name="description" content="EMS - Energy Management System" />
                <meta name="viewport" content="width=device-width" />
                <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
                <link rel="preconnect" href="https://fonts.googleapis.com" />
                <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
                <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Source+Sans+Pro:ital,wght@0,400;0,600;0,700;1,400&display=swap" />
                <meta name="generator" content={Astro.generator} />
                <title>{title}</title>
                <ClientRouter />
		<!-- Auth header for htmx, attached BEFORE htmx loads.
		     htmx fires hx-trigger="load" requests (the sidebar tree) during page
		     load, before any module script has run — so a listener registered in a
		     module is simply too late and those requests go out unauthenticated.
		     Amplify keeps the ID token in localStorage under a deterministic key,
		     so it can be read synchronously here and the race disappears.
		     The module script below still refreshes it through Amplify proper; this
		     only covers first paint. -->
		<script is:inline define:vars={{
			clientId: import.meta.env.PUBLIC_USER_POOL_CLIENT_ID,
			apiOrigins: [import.meta.env.PUBLIC_AGG_API_BASE_URL, import.meta.env.PUBLIC_DUCK_API_BASE_URL]
				.filter(Boolean).map((u) => new URL(u).origin),
		}}>
			(function () {
				// Sole owner of "which requests carry our Cognito token".
				//
				// It lives inline in <head> because htmx fires hx-trigger="load"
				// requests during page load, before any module script runs — a listener
				// registered in a module is simply too late for those. Amplify keeps the
				// ID token under a deterministic localStorage key, so it can be read
				// synchronously here and there is no race to work around.
				//
				// The module script below only refreshes window.__emsIdToken; it must not
				// restate this policy, because a second copy is a second thing to get
				// wrong — an earlier version did exactly that and attached the token to
				// every cross-origin request.
				const OWN_PATH = /^\/(command$|query\/|hierarchy\/)/;

				/** Our own APIs only: the allowlisted hosts, or a CloudFront-proxied path. */
				function isOwnApi(url) {
					try {
						const u = new URL(url, location.origin);
						return u.origin === location.origin
							? OWN_PATH.test(u.pathname)
							: apiOrigins.includes(u.origin);
					} catch { return false; }
				}

				function token() {
					if (window.__emsIdToken) return window.__emsIdToken;
					try {
						const base = "CognitoIdentityServiceProvider." + clientId;
						const user = localStorage.getItem(base + ".LastAuthUser");
						return (user && localStorage.getItem(base + "." + user + ".idToken")) || "";
					} catch { return ""; }
				}

				// Shared with the module script's 401 retry, so the rule stays single-source.
				window.__emsIsOwnApi = isOwnApi;

				const origFetch = window.fetch.bind(window);
				window.fetch = function (input, init) {
					const url = typeof input === "string" ? input : (input && input.url) || String(input);
					const t = token();
					if (!t || !isOwnApi(url)) return origFetch(input, init);
					const headers = new Headers((init && init.headers) || undefined);
					if (!headers.has("Authorization")) headers.set("Authorization", "Bearer " + t);
					return origFetch(input, Object.assign({}, init, { headers }));
				};

				document.addEventListener("htmx:configRequest", function (e) {
					const t = token();
					if (t && isOwnApi((e.detail && e.detail.path) || "") && !e.detail.headers["Authorization"]) {
						e.detail.headers["Authorization"] = "Bearer " + t;
					}
				});
			})();
		</script>
        </head>
        <body class="app-layout">

          <svg style="display: none;">
            <!-- Chevron arrow for expandable nodes -->
            <symbol id="chevron-right" viewBox="0 0 320 512">
              <path fill="currentColor" d="M299.3 244.7c6.2 6.2 6.2 16.4 0 22.6l-192 192c-6.2 6.2-16.4 6.2-22.6 0s-6.2-16.4 0-22.6L265.4 256 84.7 75.3c-6.2-6.2-6.2-16.4 0-22.6s16.4-6.2 22.6 0l192 192z"></path>
            </symbol>

            <!-- Partner: globe with meridian lines -->
            <symbol id="icon-partner" viewBox="0 0 512 512">
              <path fill="currentColor" d="M352 256c0 22.2-1.2 43.6-3.3 64l-185.3 0c-2.2-20.4-3.3-41.8-3.3-64s1.2-43.6 3.3-64l185.3 0c2.2 20.4 3.3 41.8 3.3 64zm28.8-64l123.1 0c5.3 20.5 8.1 41.9 8.1 64s-2.8 43.5-8.1 64l-123.1 0c2.1-20.6 3.2-42 3.2-64s-1.1-43.4-3.2-64zm112.6-32l-116.7 0c-10-63.9-29.8-117.4-55.3-151.6c78.3 20.7 142 77.5 171.9 151.6zm-149.1 0l-176.6 0c6.1-36.4 15.5-68.6 27-94.7c10.5-23.6 22.2-40.7 33.5-51.5C239.4 3.2 248.7 0 256 0s16.6 3.2 27.8 13.8c11.3 10.8 23 27.9 33.5 51.5c11.5 26 20.9 58.2 27 94.7zm-209.3 0L18.6 160C48.6 85.9 112.2 29.1 190.6 8.4C165.1 42.6 145.3 96.1 135.3 160zM8.1 192l123.1 0c-2.1 20.6-3.2 42-3.2 64s1.1 43.4 3.2 64L8.1 320C2.8 299.5 0 278.1 0 256s2.8-43.5 8.1-64zM194.7 446.6c-11.5-26-20.9-58.2-27-94.6l176.6 0c-6.1 36.4-15.5 68.6-27 94.6c-10.5 23.6-22.2 40.7-33.5 51.5C272.6 508.8 263.3 512 256 512s-16.6-3.2-27.8-13.8c-11.3-10.8-23-27.9-33.5-51.5zM135.3 352c10 63.9 29.8 117.4 55.3 151.6C112.2 482.9 48.6 426.1 18.6 352l116.7 0zm358.1 0c-30 74.1-93.6 130.9-171.9 151.6c25.5-34.2 45.2-87.7 55.3-151.6l116.7 0z"/>
            </symbol>

            <!-- Company: briefcase -->
            <symbol id="icon-company" viewBox="0 0 512 512">
              <path fill="currentColor" d="M184 48l144 0c4.4 0 8 3.6 8 8l0 40L176 96l0-40c0-4.4 3.6-8 8-8zm-56 8l0 40L64 96C28.7 96 0 124.7 0 160l0 96 192 0 128 0 192 0 0-96c0-35.3-28.7-64-64-64l-64 0 0-40c0-30.9-25.1-56-56-56L184 0c-30.9 0-56 25.1-56 56zM512 288l-192 0 0 32c0 17.7-14.3 32-32 32l-64 0c-17.7 0-32-14.3-32-32l0-32L0 288 0 416c0 35.3 28.7 64 64 64l384 0c35.3 0 64-28.7 64-64l0-128z"/>
            </symbol>

            <!-- Property: map/land pin -->
            <symbol id="icon-property" viewBox="0 0 576 512">
              <path fill="currentColor" d="M384 476.1L192 421.2l0-385.3L384 90.8l0 385.3zm32-1.2l0-386.5L543.1 37.5c15.8-6.3 32.9 5.3 32.9 22.3l0 334.8c0 9.8-6 18.6-15.1 22.3L416 474.8zM15.1 95.1L160 37.2l0 386.5L32.9 474.5C17.1 480.8 0 469.2 0 452.2L0 117.4c0-9.8 6-18.6 15.1-22.3z"/>
            </symbol>

            <!-- Building: single building -->
            <symbol id="icon-building" viewBox="0 0 384 512">
              <path fill="currentColor" d="M48 0C21.5 0 0 21.5 0 48L0 464c0 26.5 21.5 48 48 48l96 0 0-80c0-26.5 21.5-48 48-48s48 21.5 48 48l0 80 96 0c26.5 0 48-21.5 48-48l0-416c0-26.5-21.5-48-48-48L48 0zM64 240c0-8.8 7.2-16 16-16l32 0c8.8 0 16 7.2 16 16l0 32c0 8.8-7.2 16-16 16l-32 0c-8.8 0-16-7.2-16-16l0-32zm112-16l32 0c8.8 0 16 7.2 16 16l0 32c0 8.8-7.2 16-16 16l-32 0c-8.8 0-16-7.2-16-16l0-32c0-8.8 7.2-16 16-16zm80 16c0-8.8 7.2-16 16-16l32 0c8.8 0 16 7.2 16 16l0 32c0 8.8-7.2 16-16 16l-32 0c-8.8 0-16-7.2-16-16l0-32zM64 112c0-8.8 7.2-16 16-16l32 0c8.8 0 16 7.2 16 16l0 32c0 8.8-7.2 16-16 16l-32 0c-8.8 0-16-7.2-16-16l0-32zM176 96l32 0c8.8 0 16 7.2 16 16l0 32c0 8.8-7.2 16-16 16l-32 0c-8.8 0-16-7.2-16-16l0-32c0-8.8 7.2-16 16-16zm80 16c0-8.8 7.2-16 16-16l32 0c8.8 0 16 7.2 16 16l0 32c0 8.8-7.2 16-16 16l-32 0c-8.8 0-16-7.2-16-16l0-32z"/>
            </symbol>

            <!-- Area: grid/sections -->
            <symbol id="icon-area" viewBox="0 0 448 512">
              <path fill="currentColor" d="M0 72C0 49.9 17.9 32 40 32l48 0c22.1 0 40 17.9 40 40l0 48c0 22.1-17.9 40-40 40l-48 0C17.9 200 0 182.1 0 160L0 72zM0 232c0-22.1 17.9-40 40-40l48 0c22.1 0 40 17.9 40 40l0 48c0 22.1-17.9 40-40 40l-48 0c-22.1 0-40-17.9-40-40l0-48zM128 392l0 48c0 22.1-17.9 40-40 40l-48 0c-22.1 0-40-17.9-40-40l0-48c0-22.1 17.9-40 40-40l48 0c22.1 0 40 17.9 40 40zM160 72c0-22.1 17.9-40 40-40l48 0c22.1 0 40 17.9 40 40l0 48c0 22.1-17.9 40-40 40l-48 0c-22.1 0-40-17.9-40-40l0-48zM288 232l0 48c0 22.1-17.9 40-40 40l-48 0c-22.1 0-40-17.9-40-40l0-48c0-22.1 17.9-40 40-40l48 0c22.1 0 40 17.9 40 40zM160 392c0-22.1 17.9-40 40-40l48 0c22.1 0 40 17.9 40 40l0 48c0 22.1-17.9 40-40 40l-48 0c-22.1 0-40-17.9-40-40l0-48zM448 72l0 48c0 22.1-17.9 40-40 40l-48 0c-22.1 0-40-17.9-40-40l0-48c0-22.1 17.9-40 40-40l48 0c22.1 0 40 17.9 40 40zM320 232c0-22.1 17.9-40 40-40l48 0c22.1 0 40 17.9 40 40l0 48c0 22.1-17.9 40-40 40l-48 0c-22.1 0-40-17.9-40-40l0-48zM448 392l0 48c0 22.1-17.9 40-40 40l-48 0c-22.1 0-40-17.9-40-40l0-48c0-22.1 17.9-40 40-40l48 0c22.1 0 40 17.9 40 40z"/>
            </symbol>

            <!-- Group: folder -->
            <symbol id="icon-group" viewBox="0 0 512 512">
              <path fill="currentColor" d="M64 480H448c35.3 0 64-28.7 64-64V160c0-35.3-28.7-64-64-64H288c-10.1 0-19.6-4.7-25.6-12.8L243.2 57.6C231.1 41.5 212.1 32 192 32H64C28.7 32 0 60.7 0 96V416c0 35.3 28.7 64 64 64z"/>
            </symbol>
          </svg>

          <a href="/" class="brand" aria-label="Enity EMS">
            <img class="brand-logo" src="/images/logo-app-topleft.svg" alt="Enity EMS" width="132" height="26" />
          </a>

          <header class="top-nav">
            <Navbar />
          </header>

          <nav class="breadcrumb-nav">
            <Breadcrumb />
          </nav>

          <aside class="sidebar" transition:persist="side-menu">
            <Hierarchy />
          </aside>

          <main class="main-content main-area">
            <slot />
          </main>

          <!-- Shared hierarchy-schema designer dialog (opened from the add-child
               form when creating a company). The listener below writes its
               serialised schema into the add-child form's hidden field. -->
          <SchemaDesigner />
        </body>
</html>

<script is:inline>
  window.addEventListener("schema-updated", (e) => {
    const field = document.getElementById("add-child-schema-json");
    if (field) field.value = JSON.stringify(e.detail.schema);
    const status = document.getElementById("add-child-schema-status");
    if (status) status.textContent = "✓ skema defineret";
  });
</script>

<script>
	import 'invokers/compatible';
	import { signOut } from 'aws-amplify/auth';
	import { navigate } from 'astro:transitions/client';
	import { configureAmplify } from '../lib/amplify-config';
	import { fetchAuthSession } from 'aws-amplify/auth';
	import { resolveLevelId } from '../lib/agg';
	import { mountDeclaredCharts } from '../lib/echarts-card';
	import { applyTranslations } from '../lib/i18n';

	// Expose Astro's view-transition navigate so the hierarchy dropdowns can jump
	// to /node the same (no-full-reload) way clicking a tree node name does.
	window.emsNavigate = navigate;
	// Exposed for hx-vals expressions, so a widget can name the selected node
	// declaratively instead of re-deriving it from sessionStorage.
	window.emsLevelId = resolveLevelId;

	configureAmplify();

	// Credential policy lives in ONE place: the inline head script, which owns both
	// interceptors (fetch and htmx:configRequest) and the allowlist that decides
	// which hosts may receive the ID token. It has to run there anyway — htmx fires
	// hx-trigger="load" requests before any module executes — and restating the
	// policy here only created a second, looser copy of it.
	//
	// This block's whole job is to keep window.__emsIdToken fresh. localStorage
	// holds whatever Amplify last wrote, which can be expired; fetchAuthSession
	// refreshes it.
	const refreshToken = () => fetchAuthSession()
		.then((s) => { window.__emsIdToken = s.tokens?.idToken?.toString() ?? ''; })
		.catch(() => { window.__emsIdToken = ''; });

	refreshToken();
	document.addEventListener('astro:page-load', refreshToken);

	// Self-heal a 401 by refreshing and re-issuing once. This is the only case the
	// inline script cannot cover: it reads a token that was valid when stored and
	// has since expired.
	// Bound to `document`, not `document.body`: an Astro view transition replaces
	// the body element, taking any listener registered on it with it. htmx events
	// bubble to document either way.
	document.addEventListener('htmx:responseError', async (e) => {
		const d = e.detail;
		const cfg = d?.requestConfig ?? {};
		if (d?.xhr?.status !== 401 || !window.__emsIsOwnApi?.(cfg.path ?? '')) return;
		if (d.elt?.dataset?.authRetried) return;
		if (d.elt?.dataset) d.elt.dataset.authRetried = '1';

		await refreshToken();
		if (!window.__emsIdToken) return;
		window.htmx?.ajax(cfg.verb ?? 'get', cfg.path, {
			source: d.elt,
			target: d.target ?? d.elt,
			swap: 'innerHTML',
			values: cfg.parameters,
		});
		// Allow a later expiry to retry again; otherwise an element self-heals once
		// per page and then fails silently for the rest of the session.
		delete d.elt?.dataset?.authRetried;
	});

	function setupLogout() {
		document.getElementById('logout-btn')?.addEventListener('click', async () => {
			try {
				await signOut();
			} catch (error) {
				console.log('Logout error:', error.message);
			}
			window.location.href = '/';
		});
	}

	setupLogout();
	applyTranslations();

	// astro:page-load fires on the initial load too, so this covers both.
	document.addEventListener('astro:page-load', () => {
		setupLogout();
		applyTranslations();
		mountDeclaredCharts();
	});

	// Re-translate any HTMX-swapped fragment, and mount any chart it brought with
	// it. Scoped to the swapped subtree: most swaps (every sidebar tree expansion)
	// contain no chart at all, and rescanning the whole document each time walks
	// the entire hierarchy tree for nothing.
	// Also on `document` — see the note above. Registering this on document.body
	// meant that after the first soft navigation nothing re-translated and, worse,
	// no chart ever mounted: the fragments arrived but mountDeclaredCharts was
	// never called, so the dashboard showed its cards with empty canvases.
	document.addEventListener('htmx:afterSwap', (e) => {
		applyTranslations();
		mountDeclaredCharts(e.detail?.target ?? document);
	});

	// View transitions don't auto-process HTMX: the swapped-in DOM is new nodes
	// htmx has never seen, so hx-trigger="load" never fires on them.
	//
	// This used to process only #node-data-panel, which was enough when that was
	// the sole htmx-driven region. The whole dashboard is htmx now, so clicking a
	// node in the tree (a soft navigation) left every widget blank while a reload
	// worked — htmx processes on DOMContentLoaded there. Process the swapped
	// document instead of one element.
	//
	// after-swap fires on transitions only, never on initial load, so this cannot
	// double-fetch what DOMContentLoaded already started.
	document.addEventListener('astro:after-swap', () => {
		if (window.htmx) window.htmx.process(document.body);
	});
</script>
