---
// Footer.astro
---

<footer class="py-12 bg-gradient-to-r from-fuchsia-600 to-blue-600">
  <div class="px-4 mx-auto sm:px-6 lg:px-8 max-w-7xl">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
      <!-- Logo and Copyright section -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5 justify-items-center md:justify-items-start items-center">
        <img class="w-auto h-7" src="https://cdn.rareblocks.xyz/collection/celebration/images/logo-alt-2.svg" alt="Footer logo" />
        <p class="text-sm text-white">© Copyright 2021 Postcraft</p>
      </div>
      
      <!-- Navigation links with forced horizontal layout -->
      <div class="md:justify-self-end">
        <nav>
          <ul class="footer-nav">
            <li>
              <a href="#" class="text-sm text-white transition-all duration-200 hover:text-opacity-80 focus:text-opacity-80">About</a>
            </li>
            <li>
              <a href="#" class="text-sm text-white transition-all duration-200 hover:text-opacity-80 focus:text-opacity-80">Services</a>
            </li>
            <li>
              <a href="#" class="text-sm text-white transition-all duration-200 hover:text-opacity-80 focus:text-opacity-80">Privacy Policy</a>
            </li>
            <li>
              <a href="#" class="text-sm text-white transition-all duration-200 hover:text-opacity-80 focus:text-opacity-80">Terms & Conditions</a>
            </li>
            <li>
              <a href="#" class="text-sm text-white transition-all duration-200 hover:text-opacity-80 focus:text-opacity-80">Support</a>
            </li>
          </ul>
        </nav>
        
        <!-- Divider - only visible on mobile -->
        <div class="w-full h-px mt-6 md:hidden bg-gray-50/20"></div>
      </div>
    </div>
  </div>
</footer>

<style>
  /* Force grid layout on the navigation - with !important to override any conflicting styles */
  .footer-nav {
    display: grid !important;
    grid-template-columns: repeat(1, 1fr) !important;
    justify-items: center !important;
    gap: 0.75rem !important;
    width: 100% !important;
  }
  
  /* Force horizontal layout on desktop */
  @media (min-width: 768px) {
    .footer-nav {
      grid-template-columns: repeat(5, auto) !important;
      justify-items: end !important;
      gap: 2rem !important;
    }
  }
</style>
