---
// Resource Insights drill-down (bar). URL-param driven so the dashboard cards can
// deep-link into it; the controls rewrite the URL and re-fetch.
//
// The filter bar is static markup rendered here; only the chart and the control
// wiring are scripted, because a canvas chart cannot be a server fragment.
const RESOLUTIONS = [
  { key: "yearly", label: "År" }, { key: "monthly", label: "Måned" },
  { key: "weekly", label: "Uge" }, { key: "daily", label: "Dag" }, { key: "hourly", label: "Time" },
];
---
<div id="ri-chart-root">
  <div class="ri-filterbar">
    <div class="ri-daterange">
      <input type="date" class="form-input" id="ri-from" />
      <span>–</span>
      <input type="date" class="form-input" id="ri-to" />
    </div>
    <div class="ri-resolutions" id="ri-resolutions">
      {RESOLUTIONS.map((r) => (
        <button type="button" class="ri-res-btn" data-res={r.key}>{r.label}</button>
      ))}
    </div>
    <div class="ri-resources" id="ri-resources"></div>
  </div>
  <p class="muted chart-state" id="ri-state">Indlæser…</p>
  <div id="ri-canvas" style="width:100%;height:440px;display:none"></div>
</div>

<script>
  import {
    MEASURES, apiResolution, rollup, RESOURCE_COLORS, RESOURCE_LABELS,
    resolveLevelId, aggBase,
  } from "../lib/agg";
  import * as echarts from "echarts";
  import { drawChart } from "../lib/echarts-card";

  const MEASURE_KEYS = ["consumption", "cost", "co2e"];
  const RES_KEYS = ["hourly", "daily", "weekly", "monthly", "yearly"];

  function readParams() {
    const p = new URLSearchParams(location.search);
    const y = new Date().getFullYear();
    const m = p.get("measure") || "", r = p.get("resolution") || "";
    return {
      measure: MEASURE_KEYS.includes(m) ? m : "consumption",
      resource: p.get("resource") || "",
      from: p.get("from") || `${y}-01-01`,
      to: p.get("to") || `${y}-12-31`,
      resolution: RES_KEYS.includes(r) ? r : "monthly",
    };
  }

  function writeParams(next) {
    const p = new URLSearchParams(location.search);
    for (const [k, v] of Object.entries(next)) v ? p.set(k, v) : p.delete(k);
    history.replaceState(null, "", `${location.pathname}?${p}`);
  }

  async function boot() {
    const root = document.getElementById("ri-chart-root");
    if (!root || root.dataset.ready) return;
    root.dataset.ready = "1";

    let params = readParams();
    let rows = [];
    let selected = [];

    const $from = document.getElementById("ri-from");
    const $to = document.getElementById("ri-to");
    const $state = document.getElementById("ri-state");
    const $canvas = document.getElementById("ri-canvas");
    const $chips = document.getElementById("ri-resources");

    const setStatus = (text, isError) => {
      $state.textContent = text;
      $state.style.display = text ? "" : "none";
      $state.classList.toggle("chart-state--error", !!isError);
      $canvas.style.display = text ? "none" : "";
    };

    async function fetchRows() {
      const lvl = resolveLevelId();
      if (!lvl) { setStatus("Ingen node valgt.", true); return; }
      const def = MEASURES[params.measure];
      const qs = new URLSearchParams({
        level_id: lvl,
        resolution: apiResolution(params.resolution),
        start: new Date(`${params.from}T00:00:00Z`).toISOString(),
        end: new Date(`${params.to}T23:59:59Z`).toISOString(),
      });
      if (params.resource) qs.set("energy_type", params.resource);
      setStatus("Indlæser…");
      try {
        const res = await fetch(`${aggBase()}/meterdata/query/${def.action}?${qs}`);
        if (!res.ok) { setStatus(`Fejl: ${res.statusText}`, true); return; }
        rows = await res.json();
        if (!rows.length) { setStatus("Ingen data for perioden."); return; }
        setStatus("");
        renderChips();
        renderChart();
      } catch (e) {
        setStatus(e.message, true);
      }
    }

    function present() {
      return Array.from(new Set(rows.map((r) => r.energy_type)));
    }

    function renderChips() {
      $chips.innerHTML = present()
        .map((t) => {
          const on = !selected.length || selected.includes(t);
          return `<button type="button" class="ri-res-chip${on ? " active" : ""}" data-type="${t}"
                    style="border-color:${RESOURCE_COLORS[t] ?? "#ccc"}">${RESOURCE_LABELS[t] ?? t}</button>`;
        })
        .join("");
    }

    function renderChart() {
      const active = selected.length ? selected : present();
      const def = MEASURES[params.measure];
      const { categories, byResource, unitByResource } = rollup(
        rows.filter((r) => active.includes(r.energy_type)),
        params.resolution,
      );
      drawChart($canvas, {
        categories,
        series: Array.from(byResource.entries()).map(([t, data]) => ({
          name: RESOURCE_LABELS[t] ?? t,
          data: data.map((v) => v * def.scale),
          color: RESOURCE_COLORS[t],
          type: "bar",
        })),
        unit: def.unit || unitByResource.get(active[0]) || "",
        zoom: true,
      });
    }

    function syncControls() {
      $from.value = params.from;
      $to.value = params.to;
      for (const b of document.querySelectorAll("#ri-resolutions .ri-res-btn")) {
        b.classList.toggle("active", b.dataset.res === params.resolution);
      }
    }

    const update = (patch) => {
      params = { ...params, ...patch };
      writeParams(params);
      syncControls();
      fetchRows();
    };

    $from.addEventListener("change", () => update({ from: $from.value }));
    $to.addEventListener("change", () => update({ to: $to.value }));
    document.getElementById("ri-resolutions").addEventListener("click", (e) => {
      const b = e.target.closest(".ri-res-btn");
      if (b) update({ resolution: b.dataset.res });
    });
    $chips.addEventListener("click", (e) => {
      const b = e.target.closest(".ri-res-chip");
      if (!b) return;
      const t = b.dataset.type;
      selected = selected.includes(t) ? selected.filter((x) => x !== t) : [...selected, t];
      renderChips();
      renderChart();
    });
    // drawChart returns the instance; window.echartsInstanceFor never existed, so
    // this chart silently never resized.
    addEventListener("resize", () => echarts.getInstanceByDom($canvas)?.resize());

    syncControls();
    await fetchRows();
  }

  document.addEventListener("astro:page-load", boot);
  boot();
</script>
