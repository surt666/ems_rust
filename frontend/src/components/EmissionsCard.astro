---
// Klimaaftryk — total CO₂e for the period plus a per-energy-type breakdown.
// get_emissions returns kg; displayed as tonnes.
const { days = 30, resolution = "daily", height = 180 } = Astro.props;
---
<div id="emissions-card" data-days={days} data-resolution={resolution}>
  <p class="muted chart-state">Indlæser…</p>
  <div id="emissions-chart" style={`width:100%;height:${height}px`}></div>
</div>

<script>
  import { fetchAgg, seriesByEnergyType, RESOURCE_LABELS } from "../lib/agg";
  import { mountChart } from "../lib/echarts-card";

  const ton = (kg) => new Intl.NumberFormat("da-DK", { maximumFractionDigits: 1 }).format(kg / 1000);

  async function load() {
    const root = document.getElementById("emissions-card");
    if (!root || root.dataset.loaded) return;
    const days = Number(root.dataset.days || 30);
    const state = root.querySelector(".chart-state");
    try {
      const rows = await fetchAgg("get_emissions", { days, resolution: root.dataset.resolution || "daily" });
      if (!rows.length) { state.textContent = "Ingen emissionsdata."; return; }
      root.dataset.loaded = "1";

      const byType = new Map();
      let total = 0;
      for (const r of rows) {
        byType.set(r.energy_type, (byType.get(r.energy_type) || 0) + r.value);
        total += r.value;
      }
      const cells = [`<div><span class="muted">I alt (seneste ${days} dage)</span><strong class="mono card-total">${ton(total)} ton</strong></div>`];
      for (const [t, kg] of byType) {
        cells.push(`<div><span class="muted">${RESOURCE_LABELS[t] ?? t}</span><strong class="mono">${ton(kg)} ton</strong></div>`);
      }
      state.outerHTML = `<div class="card-metrics">${cells.join("")}</div>`;

      const s = seriesByEnergyType(rows);
      mountChart(document.getElementById("emissions-chart"), { ...s, unit: "kg CO₂e", zoom: false });
    } catch (e) {
      state.textContent = e.message;
      state.classList.add("chart-state--error");
    }
  }

  document.addEventListener("astro:page-load", load);
  load();
</script>
