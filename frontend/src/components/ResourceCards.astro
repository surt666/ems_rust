---
// Forbrugsoverblik — one card per energy type: period total, daily average and a
// sparkline, all rendered by the lambda (view=cards).
import AggWidget from "./AggWidget.astro";
const { days = 30, resolution = "daily" } = Astro.props;
---
<AggWidget action="get_aggregations" view="cards" days={days} resolution={resolution} class="rc-grid" />

<script>
  // Drill into Resource Insights for the clicked energy type. Delegated, so it
  // survives the htmx swap that replaces the cards.
  document.addEventListener("click", (e) => {
    const card = e.target.closest?.(".rc-card");
    if (!card) return;
    const url = `/rimain/?measure=consumption&resource=${encodeURIComponent(card.dataset.type)}&resolution=monthly`;
    if (window.emsNavigate) window.emsNavigate(url); else location.href = url;
  });
</script>
