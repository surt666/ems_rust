---
// Samlet omkostning — consumption × per-energy-type tariff, summed into one
// series (separate carriers on a DKK axis would invite the wrong comparison).
// Server-rendered chart config; see NodeChart.astro.
const { days = 30, resolution = "daily", height = 200 } = Astro.props;
const url = `${import.meta.env.PUBLIC_AGG_API_BASE_URL}/meterdata/query/get_cost`;
---
<div
  id="cost-chart"
  style={`width:100%;height:${height}px`}
  hx-get={url}
  hx-vals={`js:{
    level_id: window.emsLevelId(),
    resolution: '${resolution}',
    start: new Date(Date.now() - ${days} * 864e5).toISOString(),
    end: new Date().toISOString(),
    format: 'chart'
  }`}
  hx-trigger="load"
  hx-swap="innerHTML">
  <p class="muted chart-state">Indlæser…</p>
</div>
