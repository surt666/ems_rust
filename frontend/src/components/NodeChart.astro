---
// Forbrugsudvikling — one line per energy type.
//
// The lambda renders the chart config (get_aggregations?format=chart) as an
// inline application/json block; Layout's mountDeclaredCharts draws it after the
// swap. No fetch, no client-side pivoting — same transport as every other widget.
const { days = 30, resolution = "daily", height = 280 } = Astro.props;
const url = `${import.meta.env.PUBLIC_AGG_API_BASE_URL}/meterdata/query/get_aggregations`;
---
<div
  id="node-chart"
  style={`width:100%;height:${height}px`}
  hx-get={url}
  hx-vals={`js:{
    level_id: window.emsLevelId(),
    resolution: '${resolution}',
    start: new Date(Date.now() - ${days} * 864e5).toISOString(),
    end: new Date().toISOString(),
    format: 'chart'
  }`}
  hx-trigger="load"
  hx-swap="innerHTML">
  <p class="muted chart-state">Indlæser…</p>
</div>
