---
---

<div>
	<div class="lang-switcher">
		<label class="lang-label" data-i18n="login.language">Sprog</label>
		<select id="langSelect" class="lang-select">
			<option value="da">Dansk</option>
			<option value="en">English</option>
		</select>
	</div>

	<h1 class="login-form-title" data-i18n="login.title">Log ind</h1>
	<p class="login-form-subtitle" data-i18n="login.subtitle">Indtast dine oplysninger for at fortsætte</p>

	<form id="loginForm" class="form">
		<div class="form-field">
			<label for="username" class="form-label" data-i18n="login.username">Brugernavn</label>
			<input
				type="text"
				id="username"
				name="username"
				required
				class="form-input"
				placeholder="Indtast brugernavn"
				data-i18n-placeholder="login.username_placeholder"
			/>
		</div>

		<div class="form-field">
			<label for="password" class="form-label" data-i18n="login.password">Adgangskode</label>
			<div class="pw-field">
				<input
					type="password"
					id="password"
					name="password"
					required
					class="form-input"
					placeholder="Indtast adgangskode"
					data-i18n-placeholder="login.password_placeholder"
				/>
				<button
					type="button"
					id="pw-toggle"
					class="pw-toggle"
					aria-controls="password"
					aria-pressed="false"
					aria-label="Vis adgangskode"
					title="Vis adgangskode"
				>
					<svg class="pw-icon pw-icon--show" width="18" height="18" viewBox="0 0 24 24"
						fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
						<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" /><circle cx="12" cy="12" r="3" />
					</svg>
					<svg class="pw-icon pw-icon--hide" width="18" height="18" viewBox="0 0 24 24"
						fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" hidden>
						<path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94" />
						<path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19" />
						<path d="M14.12 14.12a3 3 0 1 1-4.24-4.24" /><path d="M1 1l22 22" />
					</svg>
				</button>
			</div>
		</div>

		<button type="submit" id="loginButton" class="btn-login" data-i18n="login.submit">
			Log ind
		</button>
	</form>

	<div id="errorMessage" class="login-error"></div>
	<div id="loadingMessage" class="login-loading" data-i18n="login.logging_in">Logger ind...</div>
</div>

<script>
	import { signIn, fetchAuthSession } from 'aws-amplify/auth';
	import { configureAmplify } from '../lib/amplify-config';

	// LoginLayout configures Amplify too, but these are two separate bundled
	// modules and nothing orders them — asking for the session first would just
	// get an empty one. configureAmplify is a no-op the second time.
	configureAmplify();

	// Landing on the login form while already signed in is the bug; the
	// UserAlreadyAuthenticatedException signIn throws is only its symptom. Send
	// an existing session straight on to the app.
	const goToApp = () => { window.location.href = '/main'; };

	fetchAuthSession()
		.then((session) => { if (session?.tokens?.idToken) goToApp(); })
		.catch(() => { /* no session — stay on the form */ });

	// Show/hide the password. Toggles the input type and swaps the icon; the
	// button stays outside the tab order of the form fields' natural flow only in
	// the sense that it follows the input, so keyboard users reach it right after
	// typing. aria-pressed carries the state for screen readers.
	function setupPasswordToggle() {
		const btn = document.getElementById('pw-toggle');
		const input = document.getElementById('password');
		if (!btn || !input || btn.dataset.wired) return;
		btn.dataset.wired = '1';

		btn.addEventListener('click', () => {
			const shown = input.type === 'text';
			input.type = shown ? 'password' : 'text';
			btn.setAttribute('aria-pressed', String(!shown));
			const label = shown ? 'Vis adgangskode' : 'Skjul adgangskode';
			btn.setAttribute('aria-label', label);
			btn.setAttribute('title', label);
			btn.querySelector('.pw-icon--show').hidden = !shown;
			btn.querySelector('.pw-icon--hide').hidden = shown;
			// Keep the caret where it was rather than jumping to the start.
			const pos = input.value.length;
			input.focus();
			input.setSelectionRange(pos, pos);
		});
	}

	setupPasswordToggle();
	document.addEventListener('astro:page-load', setupPasswordToggle);
	import { getLocale, setLocale, applyTranslations } from '../lib/i18n';

	function initLangSwitcher() {
		const select = document.getElementById('langSelect') as HTMLSelectElement | null;
		if (!select) return;

		select.value = getLocale();

		select.addEventListener('change', () => {
			setLocale(select.value as 'da' | 'en');
			applyTranslations();
		});
	}

	function showError(message: string) {
		const errorDiv = document.getElementById('errorMessage');
		if (errorDiv) {
			errorDiv.textContent = message;
			errorDiv.style.display = 'block';
		}
	}

	function hideError() {
		const errorDiv = document.getElementById('errorMessage');
		if (errorDiv) {
			errorDiv.style.display = 'none';
		}
	}

	function showLoading() {
		const loadingDiv = document.getElementById('loadingMessage');
		const button = document.getElementById('loginButton');
		if (loadingDiv) loadingDiv.style.display = 'block';
		if (button) button.disabled = true;
	}

	function hideLoading() {
		const loadingDiv = document.getElementById('loadingMessage');
		const button = document.getElementById('loginButton');
		if (loadingDiv) loadingDiv.style.display = 'none';
		if (button) button.disabled = false;
	}

	async function authenticateUser(username: string, password: string) {
		try {
			console.log('Starting authentication for:', username);
			showLoading();
			hideError();

			const result = await signIn({ username, password });
			console.log('SignIn result:', result);

			if (result.isSignedIn) {
				console.log('User signed in successfully');
				localStorage.setItem('loginId', username);
				hideLoading();
				window.dispatchEvent(new CustomEvent('user-authenticated'));
				goToApp();
			} else {
				console.log('Sign in not completed, result:', result);
				hideLoading();
				showError('Authentication incomplete');
			}
		} catch (error) {
			// A session that outlived the page: nothing to sign in to, just go.
			if (error?.name === 'UserAlreadyAuthenticatedException') {
				localStorage.setItem('loginId', username);
				goToApp();
				return;
			}
			console.error('Authentication error:', error);
			hideLoading();
			showError(error.message || 'Authentication failed');
		}
	}

	initLangSwitcher();
	applyTranslations();

	document.getElementById('loginForm')?.addEventListener('submit', (e) => {
		e.preventDefault();

		const username = (document.getElementById('username') as HTMLInputElement).value;
		const password = (document.getElementById('password') as HTMLInputElement).value;

		if (username && password) {
			authenticateUser(username, password);
		}
	});
</script>
