---
// Formålsopdeling — the end-use breakdown for one energy type: one stacked
// column per bucket, split by purpose.
//
// Stacked because the parts sum to the node's total by construction (crates/model
// materialises `unallocated` as the remainder), so the column height is meaningful
// and the split reads as a share of it. `total` itself is excluded server-side.
import AggWidget from "./AggWidget.astro";
const { energyType = "electricity", days = 30, height = 240 } = Astro.props;
---

<section class="card">
  <div class="section-header">
    <h2 class="section-title" style="margin-bottom:0">Formålsopdeling</h2>
    <span class="muted" style="margin-left:auto">{energyType} · seneste {days} dage</span>
  </div>
  <AggWidget
    action="get_purpose_split"
    view="chart"
    energy_type={energyType}
    days={days}
    height={height}
  />
</section>
