---
// End-use breakdown (formålsopdeling) for the selected node.
//
// HTML-over-the-wire: the aggregations lambda renders the <tr> fragment
// (get_purpose_split?format=html) and this only declares the request — same shape
// as the Data panel in pages/node.astro. The node id is client-side state, so the
// query is built by hx-vals rather than at render time; that one expression is the
// only scripting here.
//
// `unallocated` is the remainder (total − Σ declared purposes), already computed by
// crates/model. With no formulas declared it equals `total`, which is correct:
// nothing is allocated until a formula says so.
const { energyType = "electricity", days = 30 } = Astro.props;
const url = `${import.meta.env.PUBLIC_AGG_API_BASE_URL}/meterdata/query/get_purpose_split`;
---

<section class="purpose-split card">
  <div class="section-header">
    <h2 class="section-title" style="margin-bottom:0">Formålsopdeling</h2>
    <span class="muted" style="margin-left:auto">{energyType} · seneste {days} dage</span>
  </div>
  <div class="ps-scroll">
    <table>
      <thead>
        <tr>
          <th>Energiart</th><th>Formål</th><th>Tid</th>
          <th class="num">Værdi</th><th>Enhed</th><th class="num">Punkter</th>
        </tr>
      </thead>
      <tbody
        hx-get={url}
        hx-vals={`js:{
          level_id: window.emsLevelId(),
          energy_type: '${energyType}',
          resolution: 'daily',
          start: new Date(Date.now() - ${days} * 864e5).toISOString(),
          end: new Date().toISOString(),
          format: 'html'
        }`}
        hx-trigger="load"
        hx-swap="innerHTML">
        <tr><td colspan="6" class="muted">Henter…</td></tr>
      </tbody>
    </table>
  </div>
</section>

<style>
  /* Grid, not flex — project convention. */
  .purpose-split { display: grid; gap: 8px; }
  .ps-scroll { overflow-x: auto; }
  .purpose-split table { width: 100%; border-collapse: collapse; }
  .purpose-split th,
  .purpose-split :global(td) {
    padding: 4px 8px;
    border-bottom: 1px solid var(--border, #e5e7eb);
    font-size: var(--text-sm);
  }
  .purpose-split th { text-align: left; font-weight: 500; color: var(--text-muted); }
  .purpose-split th.num { text-align: right; }
  .purpose-split :global(.mono) { font-variant-numeric: tabular-nums; }
  .purpose-split :global(.muted) { color: var(--text-muted); }
</style>
