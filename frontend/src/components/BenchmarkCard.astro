---
// Bygningsbenchmark — every meter-bearing building under the node vs the
// company-average building. Rendered server-side by get_benchmark?format=html;
// this only declares the request (same shape as the Data panel in node.astro).
const { days = 30 } = Astro.props;
const url = `${import.meta.env.PUBLIC_AGG_API_BASE_URL}/meterdata/query/get_benchmark`;
---
<div
  hx-get={url}
  hx-request='{"noHeaders": true}'
  hx-vals={`js:{
    level_id: window.emsLevelId(),
    resolution: 'daily',
    start: new Date(Date.now() - ${days} * 864e5).toISOString(),
    end: new Date().toISOString(),
    format: 'html'
  }`}
  hx-trigger="load"
  hx-swap="innerHTML">
  <p class="muted">Indlæser…</p>
</div>
