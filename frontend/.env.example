# AWS Cognito Configuration
# Copy this file to .env and fill in your actual values

# Cognito User Pool ID (format: region_XXXXXXXXX)
PUBLIC_USER_POOL_ID=eu-central-1_XXXXXXXXX

# Cognito User Pool Client ID (26 character alphanumeric string)
PUBLIC_USER_POOL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# API Gateway URL (hierarchy service, account 339712745226)
PUBLIC_API_BASE_URL=https://your-api-id.execute-api.eu-central-1.amazonaws.com

# Measurements aggregations lambda — API Gateway HTTP API (daq account 891377204778).
# Set to the AggregationsApiUrl output of MeasurementsAggregateStack, WITHOUT a trailing slash.
# Serves /aggregations (chart JSON), /measurements (Datatilegnelse HTML fragment,
# raw_data via Athena) and /openapi.json — one lambda, one HTTP API.
PUBLIC_AGG_API_BASE_URL=https://your-api-id.execute-api.eu-central-1.amazonaws.com

# DuckDB raw_data reader (QueryRawStack, daq account 891377204778) — the PRIMARY
# Datatilegnelse backend (reads all.raw_data via DuckDB + iceberg, ~1.3s warm vs Athena
# ~4-6s). Set to the QueryRawApiUrl output, WITHOUT a trailing slash. Serves the same
# /meterdata/query/get_measurements path + fragment as the aggregations lambda, so the
# page falls back to PUBLIC_AGG_API_BASE_URL when this is blank.
PUBLIC_DUCK_API_BASE_URL=https://your-api-id.execute-api.eu-central-1.amazonaws.com

# Redshift Spectrum VPC lambda via API Gateway (daq account 891377204778) — the
# alternative /measurements backend selectable by the page's "Redshift (VPC)" checkbox.
# Set to the HTTP API invoke URL (no trailing slash). Leave blank to hide the toggle.
PUBLIC_REDSHIFT_API_BASE_URL=
